+/*
+ * GPU page tables (patch 1041, boot-arg whyredgpuvm=1): context bank 0 translates with a table WhyredAdreno.cpp
+ * builds. Stage 1, AArch64 descriptors (CBA2R VA64 from step 6), 36-bit addresses, 4 KiB granule, table walks
+ * non-cacheable (the tables are write-combined pool memory). Faults terminate the access (SCTLR CFCFG 0).
+ */
+#define CB_SCTLR        0x0
+#define CB_TCR2         0x10
+#define CB_TTBR0        0x20
+#define CB_TCR          0x30
+#define CB_CONTEXTIDR   0x34
+#define CB_MAIR0        0x38
+#define CB_MAIR1        0x3c
+#define CB_FSR          0x58
+#define CB_TLBIALL      0x618
+#define CB_TLBSYNC      0x7f0
+#define CB_TLBSTATUS    0x7f4
+
+bool whyred_gpu_vm_enable(uint64_t ttbr);
+void whyred_gpu_vm_disable(void);
+void whyred_gpu_tlb_flush(void);
+bool whyred_gpu_vm_write_test(uint64_t address, volatile uint32_t *cpu, uint32_t word);
+
+static volatile uint8_t *
+cb0p(void)
+{
+	return smmu + smmu_npage * smmu_psize;
+}
+
+void
+whyred_gpu_tlb_flush(void)
+{
+	volatile uint8_t *cb = cb0p();
+	__asm__ volatile ("dsb sy" ::: "memory");
+	wr(cb, CB_TLBIALL, 0);
+	wr(cb, CB_TLBSYNC, 0);
+	for (int i = 0; i < 10000 && (rd(cb, CB_TLBSTATUS) & 1u); i++) {
+		delay(1);
+	}
+}
+
+bool
+whyred_gpu_vm_enable(uint64_t ttbr)
+{
+	volatile uint8_t *cb = cb0p();
+	const uint32_t tcr = 28u | (2u << 12) | (1u << 23);    /* T0SZ 28 (36 bits), walks NC, SH0 outer, TG0 4K, EPD1 */
+	const uint32_t tcr2 = 1u | (7u << 15);                  /* PASIZE 36 bits, SEP upstream */
+	printf("WHYRED GPU: vm: CB0 TTBR0 %#llx TCR %#x TCR2 %#x, GPU fence %u\n", ttbr, tcr, tcr2, whyred_gpu_fence());
+	wr(cb, CB_SCTLR, 0x60);                                 /* translation off while the bank changes */
+	wr(cb, CB_FSR, 0xffffffffu);
+	wr(cb, CB_TCR2, tcr2);
+	wr(cb, CB_TCR, tcr);
+	wr(cb, CB_TTBR0, (uint32_t)ttbr);
+	wr(cb, CB_TTBR0 + 4, (uint32_t)(ttbr >> 32));
+	wr(cb, CB_CONTEXTIDR, 0);
+	wr(cb, CB_MAIR0, 0x44);                                 /* attr 0: normal, non-cacheable */
+	wr(cb, CB_MAIR1, 0);
+	whyred_gpu_tlb_flush();
+	wr(cb, CB_SCTLR, 0x60 | 0x7);                           /* CFIE CFRE, AFE TRE M */
+	whyred_gpu_tlb_flush();
+	printf("WHYRED GPU: vm: CB0 SCTLR %#x TCR %#x TTBR0 %#x:%#x FSR %#x\n", rd(cb, CB_SCTLR), rd(cb, CB_TCR),
+	    rd(cb, CB_TTBR0 + 4), rd(cb, CB_TTBR0), rd(cb, CB_FSR));
+	/* the kernel's own buffers through the 1:1 blocks */
+	uint32_t f = whyred_gpu_fence();
+	return fence_run(f + 1, f + 100);
+}
+
+void
+whyred_gpu_vm_disable(void)
+{
+	volatile uint8_t *cb = cb0p();
+	wr(cb, CB_SCTLR, 0xe0);                                 /* as step 6 left it */
+	whyred_gpu_tlb_flush();
+	printf("WHYRED GPU: vm: translation off again, FSR %#x FAR %#x:%#x\n", rd(cb, CB_FSR), rd(cb, 0x64), rd(cb, 0x60));
+	wr(cb, CB_FSR, 0xffffffffu);
+}
+
+/* CP_MEM_WRITE of `word` to GPU `address`, then a fence; the caller looks at `cpu` (uncached for it) */
+bool
+whyred_gpu_vm_write_test(uint64_t address, volatile uint32_t *cpu, uint32_t word)
+{
+	uint32_t fence = whyred_gpu_fence() + 1;
+	cpu[0] = 0;
+	sweet_dcache_flush((vm_offset_t)cpu, 64);
+	__asm__ volatile ("dsb sy" ::: "memory");
+	ring_put(pkt7(PKT_MEM_WRITE, 3));
+	ring_put((uint32_t)address);
+	ring_put((uint32_t)(address >> 32));
+	ring_put(word);
+	ring_put(pkt7(PKT_WAIT_FOR_IDLE, 0));
+	ring_put(pkt7(PKT_EVENT_WRITE, 4));
+	ring_put(EV_CACHE_FLUSH_TS);
+	ring_put(GMEM_PA + FENCE_OFF + 0x40);
+	ring_put(0);
+	ring_put(fence);
+	__asm__ volatile ("dsb sy" ::: "memory");
+	gwr(A5_CP_RB_WPTR, ring_w % RING_DW);
+	for (int i = 0; i < 100000 && whyred_gpu_fence() != fence; i++) {
+		delay(1);
+	}
+	sweet_dcache_flush((vm_offset_t)cpu, 64);
+	uint32_t got = cpu[0];
+	volatile uint8_t *cb = cb0p();
+	printf("WHYRED GPU: vm: write to %#llx: word %#x (want %#x), fence %u (want %u), FSR %#x\n", address, got, word,
+	    whyred_gpu_fence(), fence, rd(cb, CB_FSR));
+	return got == word && whyred_gpu_fence() == fence;
+}
