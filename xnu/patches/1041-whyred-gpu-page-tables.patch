+/*
+ * GPU page tables (patch 1041, boot-arg whyredgpuvm=1). Without them the SMMU passes addresses through and the
+ * GPU only takes physically contiguous memory: every other IOSurface was copied by the CPU each time it changed
+ * (3623 copies against 77 shared in one session). With them RedwoodGPU's translated path runs: buffers are
+ * ordinary cached kernel memory and every 4 KiB page is entered into the table.
+ *
+ * One table for everything, 36-bit addresses, 4 KiB granule. GPU 0-4 GiB maps 1:1 in four 1 GiB blocks (the
+ * kernel's ring, firmware and fence page at 0xa1400000, the pool). GPU 4-8 GiB is the window RedwoodGPU's
+ * buffers get addresses in: four level 2 tables and 2048 level 3 tables, all made up front (8 MiB of pool).
+ * Each buffer gets one unmapped 4 KiB page behind it: a GPU overrun faults instead of writing the next buffer.
+ */
+#define VM_WINDOW           0x100000000ull      /* GPU 4 GiB */
+#define VM_WINDOW_SIZE      0x100000000ull      /* 4 GiB */
+#define VM_PAGE             0x1000ull
+#define VM_TABLES_SIZE      (0x1000ull + 4 * 0x1000ull + 2048 * 0x1000ull)
+#define PTE_AF              (1ull << 10)
+#define PTE_SH_OUTER        (2ull << 8)
+#define PTE_AP_UNPRIV       (1ull << 6)
+#define PTE_AP_RDONLY       (1ull << 7)
+#define PTE_ATTRS           (PTE_AF | PTE_SH_OUTER | PTE_AP_UNPRIV)     /* AttrIndx 0: MAIR0 attr 0, normal NC */
+
+static bool vm_on;
+static uint64_t vm_tables_pa;
+static volatile uint64_t *vm_l1, *vm_l3;                /* vm_l3: 2048 tables back to back, page n of the window at [n] */
+static struct range vm_free[1024];
+static unsigned vm_free_count;
+static IOLock *vm_lock;
+
+static void
+vm_range_free(uint64_t address, uint64_t size)
+{
+	struct range *f = vm_free;
+	unsigned at;
+
+	for (at = 0; at < vm_free_count && f[at].start < address; at++) {
+	}
+	if (at > 0 && f[at - 1].start + f[at - 1].size == address) {
+		f[at - 1].size += size;
+		if (at < vm_free_count && address + size == f[at].start) {
+			f[at - 1].size += f[at].size;
+			memmove(&f[at], &f[at + 1], (--vm_free_count - at) * sizeof(f[0]));
+		}
+	} else if (at < vm_free_count && address + size == f[at].start) {
+		f[at].start = address;
+		f[at].size += size;
+	} else if (vm_free_count < sizeof(vm_free) / sizeof(vm_free[0])) {
+		memmove(&f[at + 1], &f[at], (vm_free_count - at) * sizeof(f[0]));
+		vm_free_count++;
+		f[at].start = address;
+		f[at].size = size;
+	}
+}
+
+static uint64_t
+vm_range_alloc(uint64_t size)
+{
+	struct range *f = vm_free;
+
+	for (unsigned i = 0; i < vm_free_count; i++) {
+		if (f[i].size >= size) {
+			uint64_t address = f[i].start;
+			f[i].start += size;
+			f[i].size -= size;
+			if (f[i].size == 0) {
+				memmove(&f[i], &f[i + 1], (--vm_free_count - i) * sizeof(f[0]));
+			}
+			return address;
+		}
+	}
+	return 0;
+}
+
+static inline volatile uint64_t *
+vm_pte(uint64_t address)
+{
+	return &vm_l3[(address - VM_WINDOW) / VM_PAGE];
+}
+
+/* The table, from the pool (write-combined: what is written is in memory after a barrier). */
+static bool
+vm_build(void)
+{
+	void *va = NULL;
+	vm_tables_pa = topaz_gpu_pool_alloc(VM_TABLES_SIZE, &va);
+	if (vm_tables_pa == 0) {
+		IOLog("WhyredAdreno: vm: no %llu KiB of pool for the tables\n", VM_TABLES_SIZE >> 10);
+		return false;
+	}
+	bzero(va, (size_t)VM_TABLES_SIZE);
+	vm_l1 = (volatile uint64_t *)va;
+	volatile uint64_t *l2 = vm_l1 + 512;
+	vm_l3 = l2 + 4 * 512;
+	uint64_t l2_pa = vm_tables_pa + 0x1000, l3_pa = l2_pa + 4 * 0x1000;
+	for (uint64_t g = 0; g < 4; g++) {
+		vm_l1[g] = (g << 30) | PTE_ATTRS | 1;                           /* 1 GiB block, 1:1 */
+		vm_l1[4 + g] = (l2_pa + g * 0x1000) | 3;                        /* table */
+	}
+	for (uint64_t i = 0; i < 4 * 512; i++) {
+		l2[i] = (l3_pa + i * 0x1000) | 3;
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+	vm_lock = IOLockAlloc();
+	vm_free_count = 0;
+	vm_range_free(VM_WINDOW, VM_WINDOW_SIZE);
+	IOLog("WhyredAdreno: vm: tables at %#llx (L1, 4 L2, 2048 L3), window %#llx + %llu MiB\n", vm_tables_pa, VM_WINDOW,
+	    VM_WINDOW_SIZE >> 20);
+	return true;
+}
+
+/*
+ * From whyred_gpu.c before RedwoodGPU is published: build the table, turn translation on (fences through the 1:1
+ * part checked there), then map one kernel page into the window and let the GPU write to it. Any failure turns
+ * translation off again: the identity path stays.
+ */
+void
+whyred_gpu_vm_start(void)
+{
+	if (!vm_build()) {
+		return;
+	}
+	if (!whyred_gpu_vm_enable(vm_tables_pa)) {
+		whyred_gpu_vm_disable();
+		IOLog("WhyredAdreno: vm: fences failed with translation on, staying 1:1\n");
+		return;
+	}
+	IOBufferMemoryDescriptor *page = IOBufferMemoryDescriptor::inTaskWithOptions(kernel_task, kIODirectionInOut, 16384, 16384);
+	uint64_t pa = page != NULL ? page->getPhysicalSegment(0, NULL, kIOMemoryMapperNone) : 0;
+	uint64_t gva = vm_range_alloc(0x8000);
+	bool ok = pa != 0 && gva != 0;
+	if (ok) {
+		for (uint64_t o = 0; o < 0x4000; o += VM_PAGE) {
+			*vm_pte(gva + o) = (pa + o) | PTE_ATTRS | 3;
+		}
+		whyred_gpu_tlb_flush();
+		volatile uint32_t *cpu = (volatile uint32_t *)((uint8_t *)page->getBytesNoCopy() + 0x1230);
+		ok = whyred_gpu_vm_write_test(gva + 0x1230, cpu, 0x76a10041u);
+		for (uint64_t o = 0; o < 0x4000; o += VM_PAGE) {
+			*vm_pte(gva + o) = 0;
+		}
+		whyred_gpu_tlb_flush();
+		vm_range_free(gva, 0x8000);
+	}
+	IOLog("WhyredAdreno: vm: test page at %#llx as GPU %#llx: %s\n", pa, gva, ok ? "translation works" : "FAILED");
+	OSSafeReleaseNULL(page);
+	if (!ok) {
+		whyred_gpu_vm_disable();
+		return;
+	}
+	vm_on = true;
+}
