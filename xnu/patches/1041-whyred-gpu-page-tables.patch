-	(void)address;
-	(void)size;
+	if (!vm_on || address < VM_WINDOW) {
+		return;
+	}
+	size = (size + VM_PAGE - 1) & ~(VM_PAGE - 1);
+	for (uint64_t o = 0; o < size && address + o < VM_WINDOW + VM_WINDOW_SIZE; o += VM_PAGE) {
+		*vm_pte(address + o) = 0;
