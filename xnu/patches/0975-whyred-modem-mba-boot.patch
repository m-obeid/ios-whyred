+/* n bytes at off of file i, following its cluster chain and reading contiguous runs at once */
+static bool
+fw_all_read(int i, uint64_t off, void *dst, uint64_t n)
+{
+	if (i < 0 || (unsigned)i >= fat_count || off + n > fat_files[i].size) {
+		return false;
+	}
+	uint32_t c = fat_files[i].clus;
+	for (uint64_t skip = off / fat_clus_bytes; skip > 0; skip--) {
+		c = fat_next(c);
+	}
+	uint64_t in = off % fat_clus_bytes, done = 0;
+	while (done < n) {
+		if (c < 2 || c >= 0x0ffffff8) {
+			return false;
+		}
+		uint32_t run = 1, last = c;
+		while ((uint64_t)run * fat_clus_bytes - in < n - done && fat_next(last) == last + 1 && run < 256) {
+			last++;
+			run++;
+		}
+		uint64_t take = MIN((uint64_t)run * fat_clus_bytes - in, n - done);
+		if (!fat_part_read(fat_data_off + (uint64_t)(c - 2) * fat_clus_bytes + in, (uint8_t *)dst + done, take)) {
+			return false;
+		}
+		done += take;
+		in = 0;
+		c = fat_next(last);
+	}
+	return true;
+}
