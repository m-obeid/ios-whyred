+/*
+ * whyred: read-only access to any GPT partition by name, for the modem firmware ("modem", FAT)
+ * and its EFS partitions (modemst1/2, fsg, fsc): iokit/Kernel/arm/TopazModem.cpp. Same shape as
+ * sweet_ufs_read_part on topaz. EAGAIN until the driver is up.
+ */
+int sweet_emmc_read_part(const char *want, uint64_t off, void *dst, uint64_t len);
+
+static struct {
+	char name[24];
+	uint64_t first, sectors;
+} part_cache[8];
+static unsigned part_cached;
+
+static int
+part_lookup(const char *want, uint64_t *first, uint64_t *sectors)
+{
+	for (unsigned i = 0; i < part_cached; i++) {
+		if (strcmp(part_cache[i].name, want) == 0) {
+			*first = part_cache[i].first;
+			*sectors = part_cache[i].sectors;
+			return 0;
+		}
+	}
+	const uint8_t *b = (const uint8_t *)(se.dma + DMA_BOUNCE);
+	int error = emmc_read(1, 1);
+	if (error) {
+		return error;
+	}
+	uint64_t entry_lba;
+	uint32_t nent, esz;
+	memcpy(&entry_lba, b + 72, 8);
+	memcpy(&nent, b + 80, 4);
+	memcpy(&esz, b + 84, 4);
+	if (memcmp(b, "EFI PART", 8) != 0 || esz != 128 || nent == 0 || nent > 256) {
+		return ENXIO;
+	}
+	error = emmc_read(entry_lba, (nent * esz + SECTOR - 1) / SECTOR);
+	if (error) {
+		return error;
+	}
+	for (uint32_t i = 0; i < nent; i++) {
+		const uint8_t *e = b + i * esz;
+		char name[37];
+		unsigned c;
+		for (c = 0; c < 36; c++) {
+			uint16_t ch = (uint16_t)(e[56 + 2 * c] | e[57 + 2 * c] << 8);
+			if (ch == 0 || ch > 0x7f) {
+				break;
+			}
+			name[c] = (char)ch;
+		}
+		name[c] = 0;
+		if (strcmp(name, want) != 0) {
+			continue;
+		}
+		uint64_t f, l;
+		memcpy(&f, e + 32, 8);
+		memcpy(&l, e + 40, 8);
+		if (l < f || l + 1 > se.card_sectors) {
+			return ENXIO;
+		}
+		*first = f;
+		*sectors = l - f + 1;
+		if (part_cached < sizeof(part_cache) / sizeof(part_cache[0])) {
+			strlcpy(part_cache[part_cached].name, want, sizeof(part_cache[0].name));
+			part_cache[part_cached].first = f;
+			part_cache[part_cached].sectors = *sectors;
+			part_cached++;
+		}
+		return 0;
+	}
+	return ENOENT;
+}
+
+int
+sweet_emmc_read_part(const char *want, uint64_t off, void *dst, uint64_t len)
+{
+	uint64_t first = 0, sectors = 0;
+	int error;
+
+	if (!se.ready) {
+		return EAGAIN;
+	}
+	lck_mtx_lock(&sweet_emmc_lock);
+	error = part_lookup(want, &first, &sectors);
+	if (!error && (off > sectors * SECTOR || len > sectors * SECTOR - off)) {
+		error = EINVAL;
+	}
+	for (uint64_t done = 0; !error && done < len;) {
+		uint64_t pos = off + done;
+		uint32_t skip = (uint32_t)(pos % SECTOR);
+		uint32_t take = (uint32_t)MIN(len - done, (uint64_t)(BOUNCE_SIZE - skip));
+		error = emmc_read(first + pos / SECTOR, (skip + take + SECTOR - 1) / SECTOR);
+		if (!error) {
+			memcpy((uint8_t *)dst + done, (const uint8_t *)(se.dma + DMA_BOUNCE) + skip, take);
+			done += take;
+		}
+	}
+	lck_mtx_unlock(&sweet_emmc_lock);
+	return error;
+}
