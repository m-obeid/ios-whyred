+/*
+ * whyred: the stock "modem" partition is FAT16 (NON-HLOS). At mount the FAT is read whole and the
+ * root plus each top-level directory are listed into fat_files ("image/modem.b00"). Files are
+ * read cluster run by cluster run through sweet_emmc_read_part. 8.3 names, lower case (vfat
+ * shortname=lower, as Linux mounts it); long-name entries are skipped.
+ */
+struct fat_file { char path[40]; uint32_t size, clus; };
+static struct fat_file *fat_files;
+static unsigned fat_count, fat_max = 1024;
+static uint16_t *fat_tab;                       /* FAT16 */
+static uint32_t fat_entries, fat_spc, fat_clus_bytes;
+static uint64_t fat_data_off, fat_root_off;
+static uint32_t fat_root_bytes;
+
+static bool
+fat_part_read(uint64_t off, void *dst, uint64_t n)
+{
+	return sweet_ufs_read_part(fw_part, off, dst, n) == 0;
+}
+
+static uint32_t
+fat_next(uint32_t c)
+{
+	uint32_t v = c < fat_entries ? fat_tab[c] : 0xffff;
+	return v >= 0xfff8 ? 0x0fffffff : v;
+}
+
+static void
+fat_add_dir(const uint8_t *d, uint32_t bytes, const char *prefix, bool recurse);
+
+static void
+fat_list_clusters(uint32_t clus, const char *prefix)
+{
+	uint8_t *buf = (uint8_t *)IOMalloc(fat_clus_bytes);
+	for (unsigned guard = 0; buf != NULL && clus >= 2 && clus < 0x0ffffff8 && guard < 4096; guard++) {
+		if (!fat_part_read(fat_data_off + (uint64_t)(clus - 2) * fat_clus_bytes, buf, fat_clus_bytes)) {
+			break;
+		}
+		fat_add_dir(buf, fat_clus_bytes, prefix, false);
+		clus = fat_next(clus);
+	}
+	if (buf != NULL) {
+		IOFree(buf, fat_clus_bytes);
+	}
+}
+
+static void
+fat_add_dir(const uint8_t *d, uint32_t bytes, const char *prefix, bool recurse)
+{
+	for (uint32_t o = 0; o + 32 <= bytes; o += 32) {
+		const uint8_t *e = d + o;
+		if (e[0] == 0) {
+			return;
+		}
+		if (e[0] == 0xe5 || e[0] == '.' || e[11] == 0x0f || (e[11] & 0x08)) {
+			continue;
+		}
+		char name[13];
+		unsigned n = 0;
+		for (unsigned i = 0; i < 8 && e[i] != ' '; i++) {
+			name[n++] = (char)(e[i] >= 'A' && e[i] <= 'Z' ? e[i] + 32 : e[i]);
+		}
+		if (e[8] != ' ') {
+			name[n++] = '.';
+			for (unsigned i = 8; i < 11 && e[i] != ' '; i++) {
+				name[n++] = (char)(e[i] >= 'A' && e[i] <= 'Z' ? e[i] + 32 : e[i]);
+			}
+		}
+		name[n] = 0;
+		uint32_t clus = e[26] | e[27] << 8, size = e[28] | e[29] << 8 | e[30] << 16 | (uint32_t)e[31] << 24;
+		char path[40];
+		snprintf(path, sizeof(path), "%s%s", prefix, name);
+		if (e[11] & 0x10) {
+			if (recurse) {
+				char sub[40];
+				snprintf(sub, sizeof(sub), "%s/", path);
+				fat_list_clusters(clus, sub);
+			}
+			continue;
+		}
+		if (fat_count < fat_max) {
+			strlcpy(fat_files[fat_count].path, path, sizeof(fat_files[0].path));
+			fat_files[fat_count].size = size;
+			fat_files[fat_count].clus = clus;
+			fat_count++;
+		}
+	}
+}
