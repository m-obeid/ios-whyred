diff --git a/bsd/dev/redwood_apple80211.c b/bsd/dev/redwood_apple80211.c
index e2674ee..c6c750c 100644
--- a/bsd/dev/redwood_apple80211.c
+++ b/bsd/dev/redwood_apple80211.c
@@ -41,6 +41,10 @@
 #include <sys/redwood_input.h>
 #include <sys/redwood_net.h>
 #include <sys/redwood_sta.h>
+#include <sys/sysctl.h>
+
+static int32_t last_rssi;                       /* whyred: what RSSI (16) answered last */
+static unsigned rssi_asked;
 #include <sys/sockio.h>
 #include <sys/systm.h>
 
@@ -193,7 +197,29 @@ _Static_assert(sizeof(struct apple80211_scan_result) == 1164 && offsetof(struct
 
 /* Apple80211's events (APPLE80211_M_...) */
 enum { EVENT_POWER_CHANGED = 1, EVENT_SSID_CHANGED = 2, EVENT_BSSID_CHANGED = 3, EVENT_LINK_CHANGED = 4, EVENT_ASSOC_DONE = 9,
-       EVENT_SCAN_DONE = 10 };
+       EVENT_SCAN_DONE = 10, EVENT_LINK_QUALITY = 17 };
+
+/*
+ * whyred: the status bar's Wi-Fi bars stayed empty: wifid asked RSSI only a few times and expects
+ * APPLE80211_M_LINK_QUALITY events (struct apple80211_link_qual_event_data: rssi dBm, tx rate).
+ * Posted when the link comes up and after every scan while joined.
+ */
+static void post(uint32_t code, const void *data, uint32_t length);
+
+static void
+post_link_quality(void)
+{
+	struct redwood_sta_state *state = kalloc_data(sizeof(*state), Z_WAITOK | Z_ZERO);
+	if (state == NULL) {
+		return;
+	}
+	redwood_sta_state(state);
+	if (state->phase == REDWOOD_STA_JOINED) {
+		struct { int32_t rssi_dbm; uint32_t tx_rate; } q = { state->bss.rssi, 72 };
+		post(EVENT_LINK_QUALITY, &q, sizeof(q));
+	}
+	kfree_data(state, sizeof(*state));
+}
 
 static const char interface_name[16] = "en0";   /* (bsd/dev/redwood_net.c makes one interface, and that is its name) */
 
@@ -431,6 +457,8 @@ get(struct apple80211req *request)
 			     .each_ext = { state->bss.rssi }, .all_ext = state->bss.rssi };
 
 		error = state->phase != REDWOOD_STA_JOINED ? ENXIO : give(request, &answer, sizeof(answer));
+		last_rssi = state->bss.rssi;
+		rssi_asked++;
 		break;
 	}
 	case 103:                               /* all of it, as a scan's result */
@@ -633,6 +661,7 @@ redwood_apple80211_event(enum redwood_sta_event event, int status)
 		result_next = 0;
 		lck_mtx_unlock(&apple80211_lock);
 		post(EVENT_SCAN_DONE, NULL, 0);
+		post_link_quality();
 		break;
 	case REDWOOD_STA_JOIN_DONE:
 		lck_mtx_lock(&apple80211_lock);
@@ -653,6 +682,7 @@ redwood_apple80211_event(enum redwood_sta_event event, int status)
 		post(EVENT_SSID_CHANGED, NULL, 0);
 		post(EVENT_BSSID_CHANGED, NULL, 0);
 		post(EVENT_LINK_CHANGED, &link, sizeof(link));
+		post_link_quality();
 		break;
 	}
 	}
@@ -694,12 +724,7 @@ note(const struct apple80211req *request, bool is_set, int error)
 void
 redwood_apple80211_summary(void)
 {
-	static bool said;
-
-	if (said) {
-		return;
-	}
-	said = true;
+	printf("apple80211: RSSI asked %u times, last answer %d dBm\n", rssi_asked, last_rssi);
 	for (unsigned i = 0; i < kind_count; i++) {
 		printf("apple80211: in this run: %s %d (%s) %u times, answered %u times%s", kinds[i].set ? "set" : "get", kinds[i].type,
 		    type_name(kinds[i].type), kinds[i].times, kinds[i].answered, kinds[i].last_error == 0 ? "\n" : "");
@@ -737,3 +762,17 @@ redwood_apple80211_ioctl(u_long command, void *data)
 	}
 	return error;
 }
+
+/* whyred: sysctl kern.whyred_a80211=1 prints what was asked so far (the request log stops at 800 lines) */
+static int
+whyred_a80211_sysctl SYSCTL_HANDLER_ARGS
+{
+#pragma unused(oidp, arg1, arg2)
+	int v = 0, error = sysctl_handle_int(oidp, &v, 0, req);
+	if (error == 0 && req->newptr != USER_ADDR_NULL && v != 0) {
+		redwood_apple80211_summary();
+	}
+	return error;
+}
+SYSCTL_PROC(_kern, OID_AUTO, whyred_a80211, CTLTYPE_INT | CTLFLAG_RW | CTLFLAG_LOCKED, NULL, 0,
+    whyred_a80211_sysctl, "I", "print the Apple80211 request counters");
