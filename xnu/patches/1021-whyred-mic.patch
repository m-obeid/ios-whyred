+/* For TopazAudio (the microphone's bias supply): one vote in the active and the sleep set. */
+extern "C" bool
+whyred_rpm_vote(uint32_t type, uint32_t id, const uint32_t *kv, unsigned pairs)
+{
+	if (!rpm_up && !rpm_open()) {
+		return false;
+	}
+	bool a = rpm_request(0, type, id, kv, pairs);
+	bool b = rpm_request(1, type, id, kv, pairs);
+	return a && b;
+}
