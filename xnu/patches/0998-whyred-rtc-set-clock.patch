diff --git a/bsd/dev/whyred_spmi.c b/bsd/dev/whyred_spmi.c
index c3a170c..3c17608 100644
--- a/bsd/dev/whyred_spmi.c
+++ b/bsd/dev/whyred_spmi.c
@@ -13,6 +13,7 @@
 #include <machine/machine_routines.h>
 #include <kern/locks.h>
 #include <sys/sysctl.h>
+#include <pexpert/pexpert.h>
 
 extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
 int whyred_spmi_init(void);
@@ -236,4 +237,37 @@ sysctl_whyred_rtc SYSCTL_HANDLER_ARGS
 
 SYSCTL_PROC(_kern, OID_AUTO, whyred_rtc, CTLTYPE_QUAD | CTLFLAG_RD | CTLFLAG_LOCKED, NULL, 0,
     sysctl_whyred_rtc, "Q", "whyred: PM660 RTC seconds (not the date: add the saved offset)");
+
+/*
+ * Called from SweetBattery's 1 s timer. While the calendar reads before 2023, set it to the RTC plus
+ * boot-arg whyred_rtcoff (the phone's /var/root/whyred_rtc_offset). This runs before launchd, so dasd
+ * no longer saves 1970 dates; the launchd job started too late for that (2026-11-23).
+ */
+void whyred_rtc_set_clock(void);
+void
+whyred_rtc_set_clock(void)
+{
+	static bool parsed;
+	static int64_t off = -1;
+	if (!parsed) {
+		parsed = true;
+		if (!PE_parse_boot_argn("whyred_rtcoff", &off, sizeof(off))) {
+			off = -1;
+		}
+	}
+	if (off <= 0) {
+		return;
+	}
+	clock_sec_t s;
+	clock_usec_t us;
+	clock_get_calendar_microtime(&s, &us);
+	if (s >= 1700000000) {
+		return;
+	}
+	uint32_t secs;
+	if (whyred_spmi_init() == 0 && ws_rtc(&secs) == 0) {
+		clock_set_calendar_microtime((clock_sec_t)(secs + off), 0);
+		printf("WHYRED RTC: clock set to %lld (rtc %u + offset %lld)\n", (long long)(secs + off), secs, off);
+	}
+}
 #endif /* ARM64_BOARD_CONFIG_SWEET */
