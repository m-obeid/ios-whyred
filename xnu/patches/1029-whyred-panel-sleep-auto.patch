+/*
+ * whyred TD4310: DCS sleep as the DT off-command (0x28, 20 ms, 0x10, 120 ms, high speed) and wake as Linux does
+ * (0x11, 120 ms, 0x29, low power). The video stream keeps running. Each step ends with a power mode read (0x0A):
+ * 0x08 asleep, 0x1c awake. Called with the WLED off, from thread calls (it sleeps).
+ */
+void
+AppleCLCD::panelSleep(bool in)
+{
+	const uint8_t a[4] = { (uint8_t)(in ? 0x28 : 0x11), 0, 0x05, 0x80 };
+	const uint8_t b[4] = { (uint8_t)(in ? 0x10 : 0x29), 0, 0x05, 0x80 };
+	const uint8_t max[4] = { 1, 0, 0x37, 0x80 }, rd[4] = { 0x0a, 0, 0x06, 0xa0 };
+	int hs = in ? 1 : 0;
+	IOLockLock(fPanelLock);
+	IOLockLock(fLock);
+	bool off = fPowerOff;
+	IOLockUnlock(fLock);
+	if (in == fPanelAsleep || (in && !off)) {
+		IOLockUnlock(fPanelLock);
+		return;                 /* nothing to do, or turned back on meanwhile */
+	}
+	IOLockLock(fBlLock);
+	bool done = dsiSend(a, NULL, 0, hs);
+	IOLockUnlock(fBlLock);
+	IOSleep(in ? 20 : 120);
+	IOLockLock(fBlLock);
+	done &= dsiSend(b, NULL, 0, hs);
+	IOLockUnlock(fBlLock);
+	IOSleep(in ? 120 : 20);
+	IOLockLock(fBlLock);
+	bool rdone = dsiSend(max, NULL, 0, 0) && dsiSend(rd, NULL, 0, 0);
+	IODelay(500);
+	uint32_t mode = dsi_rd(fDsiCmd, 0x06c);
+	IOLockUnlock(fBlLock);
+	fPanelAsleep = in;
+	IOLockUnlock(fPanelLock);
+	IOLog("SWEET FB: panel %s: %s, power mode %#x\n", in ? "sleep in" : "sleep out",
+	    done ? "done" : "NOT DONE", rdone && (mode >> 24) == 0x21 ? (mode >> 16) & 0xff : 0xffffffffu);
+}
