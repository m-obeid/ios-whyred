 /* ---- network interface (ue0) ---- */
 
+/* Start a transfer of n prepared TRBs at DMA offset ring on physical endpoint ep. */
+static void
+ud_start_ring(unsigned ep, uint32_t ring, unsigned n)
+{
+	ud_sync(ring, 16 * n);
+	uint64_t tpa = ud.dma_pa + ring;
+	if (ud_epcmd(ep, DEPCMD_STARTTRANSFER, (uint32_t)(tpa >> 32), (uint32_t)tpa, 0) == 0) {
+		ud.res[ep & 7] = (uint8_t)((dwc_rd(DEPCMD(ep)) >> 16) & 0x7f);
+		ud.active |= 1u << ep;
+	}
+}
+
+/*
+ * UD_RING receive buffers in one transfer. CSP lets a short packet (the end of a frame) move on
+ * to the next TRB; IOC on every TRB gives an XferInProgress event per frame, so frames are
+ * delivered at once. The ring is armed again after XferComplete (its last TRB).
+ */
 static void
 ud_rx_arm(void)
 {
-	ud_start_trb(EP_RX, UD_TRB_RX, UD_RX, UD_FRAME_MAX, TRBCTL_NORMAL);
+	volatile uint32_t *t = (volatile uint32_t *)(ud.dma + UD_RING_RX);
+	for (unsigned i = 0; i < UD_RING; i++, t += 4) {
+		uint64_t bpa = ud.dma_pa + UD_RX + i * UD_FRAME_MAX;
+		t[0] = (uint32_t)bpa;
+		t[1] = (uint32_t)(bpa >> 32);
+		t[2] = UD_FRAME_MAX;
+		t[3] = TRBCTL_NORMAL | TRB_HWO | TRB_CSP | TRB_ISP_IMI | TRB_IOC | (i == UD_RING - 1 ? TRB_LST : 0);
+	}
+	ud_sync(UD_RX, UD_RING * UD_FRAME_MAX);
+	ud.rx_pos = 0;
+	ud_start_ring(EP_RX, UD_RING_RX, UD_RING);
+}
+
+static void ud_rx_frame(uint32_t buf, uint32_t len);
+
+/* Deliver every finished RX TRB; after XferComplete arm the ring again. */
+static void
+ud_rx_done(bool complete)
+{
+	while (ud.rx_pos < UD_RING) {
+		uint32_t trb = UD_RING_RX + 16 * ud.rx_pos;
+		volatile uint32_t *t = (volatile uint32_t *)(ud.dma + trb);
+		ud_sync(trb, 16);
+		if (t[3] & TRB_HWO) {
+			break;
+		}
+		uint32_t buf = UD_RX + ud.rx_pos * UD_FRAME_MAX;
+		ud_sync(buf, UD_FRAME_MAX);
+		ud_rx_frame(buf, UD_FRAME_MAX - (t[2] & 0xffffff));
+		ud.rx_pos++;
+	}
+	if (complete) {
+		ud_rx_arm();
+	}
 }
 
