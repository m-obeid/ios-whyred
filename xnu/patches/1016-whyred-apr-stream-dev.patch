+/* frames from /dev/topaz-audio: never waits; returns how many were taken */
+static uint32_t
+as_write(const int16_t *frames, uint32_t count)
+{
+	IOLockLock(as_lock);
+	uint32_t bytes = MIN(count * 4, AS_RING_BYTES / 2);
+	uint32_t r = as_sent_off, w = as_write_off;
+	uint32_t ahead = (w + AS_RING_BYTES - r) % AS_RING_BYTES;
+	if (!as_playing || ahead > AS_RING_BYTES / 2) {          /* not started, or the ADSP passed us */
+		if (as_playing) {
+			as_underruns++;
+		}
+		w = (r + AS_LEAD) % AS_RING_BYTES;
+		ahead = AS_LEAD;
+	}
+	if (ahead + bytes > AS_RING_BYTES - 4096) {
+		uint32_t room = AS_RING_BYTES - 4096 > ahead ? (AS_RING_BYTES - 4096 - ahead) & ~3u : 0;
+		as_dropped += (bytes - room) / 4;
+		bytes = room;
+	}
+	int32_t g = (int32_t)as_gain_q15;
+	for (uint32_t i = 0; i < bytes / 2; i++) {
+		uint32_t at = (w + 2 * i) % AS_RING_BYTES;
+		*(int16_t *)(as_ring + at) = (int16_t)(((int32_t)frames[i] * g) >> 15);
 	}
+	uint32_t z = (w + bytes) % AS_RING_BYTES, zl = 2 * AS_LEAD, z1 = MIN(zl, AS_RING_BYTES - z);
+	bzero(as_ring + z, z1);
+	bzero(as_ring, zl - z1);
+	mb();
+	as_write_off = (w + bytes) % AS_RING_BYTES;
+	as_frames_in += bytes / 4;
+	as_last_write = mach_absolute_time();
+	IOLockUnlock(as_lock);
+	return count;
+}
 
