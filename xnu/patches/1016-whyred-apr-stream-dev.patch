+/* tas2557 startup (on) or shutdown (off) data, as Linux p_tas2557_startup_data / _shutdown_data */
+static int
+tas_power(bool on)
+{
+	int r = 0;
+	if (on) {
+		r |= tas_wr(0, 1, 77, 0x15);
+		r |= tas_wr(0, 1, 61, 0x01);
+		r |= tas_wr(0, 1, 62, 0x01);
+		r |= tas_wr(0, 0, 5, 0xa0);
+		r |= tas_wr(0, 0, 5, 0xa3);
+		r |= tas_wr(0, 0, 4, 0xf8);
+		IODelay(2000);
+		r |= tas_wr(0, 0, 44, 0x2b);
+		r |= tas_wr(0, 0, 7, 0x00);
+		r |= tas_wr(100, 0, 7, 0x00);
+	} else {
+		r |= tas_wr(0, 0, 44, 0x00);
+		r |= tas_wr(100, 0, 7, 0x01);
+		IOSleep(10);
+		r |= tas_wr(0, 0, 7, 0x03);
+		r |= tas_wr(0, 0, 4, 0x60);
+		IODelay(2000);
+		r |= tas_wr(0, 0, 5, 0x00);
+		r |= tas_wr(0, 0, 4, 0x00);
+		r |= tas_wr(0, 1, 61, 0x00);
+		r |= tas_wr(0, 1, 62, 0x00);
+		r |= tas_wr(0, 1, 77, 0x00);
+	}
+	return r;
+}
