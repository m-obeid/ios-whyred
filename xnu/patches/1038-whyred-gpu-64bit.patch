+/* highest physical address a buffer the GPU uses may end at (RedwoodGPU.cpp, surfaces shared as they are) */
+uint64_t
+redwood_gpu_reach(void)
+{
+	return whyred_gpu_reach();
+}
+
+/*
+ * For whyred_gpu.c's high test: one write-combined page above 4 GiB. Pages are taken until one lies there
+ * (XNU's RAM is 0xb2000000 + 0xcc000000, most of it above 4 GiB); the others go back.
+ */
+static IOBufferMemoryDescriptor *high_page;
+
+uint64_t
+whyred_high_page(volatile uint32_t **va)
+{
+	IOBufferMemoryDescriptor *tried[32];
+	unsigned n = 0;
+	uint64_t pa = 0;
+
+	*va = NULL;
+	while (n < 32) {
+		IOBufferMemoryDescriptor *m = IOBufferMemoryDescriptor::inTaskWithPhysicalMask(kernel_task,
+		    kIODirectionInOut | kIOMemoryPhysicallyContiguous | kIOMapWriteCombineCache, 4096, 0x0000000ffffff000ull);
+		if (m == NULL) {
+			break;
+		}
+		uint64_t p = m->getPhysicalSegment(0, NULL, kIOMemoryMapperNone);
+		if (p >= (1ull << 32)) {
+			high_page = m;
+			pa = p;
+			*va = (volatile uint32_t *)m->getBytesNoCopy();
+			break;
+		}
+		tried[n++] = m;
+	}
+	for (unsigned i = 0; i < n; i++) {
+		tried[i]->release();
+	}
+	return pa;
+}
+
+void
+whyred_high_page_free(void)
+{
+	OSSafeReleaseNULL(high_page);
+}
