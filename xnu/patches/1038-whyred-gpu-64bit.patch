+/*
+ * CP_MEM_WRITE into a page above 4 GiB (WhyredAdreno.cpp finds one), then a fence. The word seen there: the GPU
+ * reaches all RAM, so surfaces above 4 GiB may be shared (the first GPU UI boot drew into 0x171714000 in 32-bit
+ * mode, the write went to 0x71714000 and the phone reset).
+ */
+uint64_t whyred_high_page(volatile uint32_t **va);     /* WhyredAdreno.cpp */
+void whyred_high_page_free(void);
+
+static void
+high_test(void)
+{
+	volatile uint32_t *va = NULL;
+	uint64_t pa = whyred_high_page(&va);
+	if (pa < (1ull << 32) || va == NULL) {
+		printf("WHYRED GPU: high test: no page above 4 GiB (%#llx), GPU kept below 4 GiB\n", pa);
+		whyred_high_page_free();
+		return;
+	}
+	uint32_t fence = *gmw(FENCE_OFF + 0x40) + 1;
+	va[0] = 0;
+	__asm__ volatile ("dsb sy" ::: "memory");
+	ring_put(pkt7(PKT_MEM_WRITE, 3));
+	ring_put((uint32_t)pa);
+	ring_put((uint32_t)(pa >> 32));
+	ring_put(0x6464abcdu);
+	ring_put(pkt7(PKT_WAIT_FOR_IDLE, 0));
+	ring_put(pkt7(PKT_EVENT_WRITE, 4));
+	ring_put(EV_CACHE_FLUSH_TS);
+	ring_put(GMEM_PA + FENCE_OFF + 0x40);
+	ring_put(0);
+	ring_put(fence);
+	__asm__ volatile ("dsb sy" ::: "memory");
+	gwr(A5_CP_RB_WPTR, ring_w % RING_DW);
+	for (int i = 0; i < 100000 && *gmw(FENCE_OFF + 0x40) != fence; i++) {
+		delay(1);
+	}
+	uint32_t got = va[0];
+	bool ok = *gmw(FENCE_OFF + 0x40) == fence && got == 0x6464abcdu;
+	if (ok) {
+		gpu_reach = 1ull << 36;
+	}
+	printf("WHYRED GPU: high test at %#llx: word %#x (want 0x6464abcd), fence %u (want %u): %s\n", pa, got,
+	    *gmw(FENCE_OFF + 0x40), fence, ok ? "GPU reaches 64 GiB" : "GPU kept below 4 GiB");
+	whyred_high_page_free();
+}
