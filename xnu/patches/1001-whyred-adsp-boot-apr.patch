+/* ---------------------------------------------------------------- APR (whyred) */
+
+#define ACHAN                       "apr_audio_svc"
+#define APR_MSG_TYPE_SEQ_CMD        2
+#define APR_HDR_BYTES               20
+#define APR_HDR_FIELD               ((APR_MSG_TYPE_SEQ_CMD << 8) | ((APR_HDR_BYTES / 4) << 4) | 0)
+#define APR_DOMAIN_ADSP             4
+#define APR_DOMAIN_APPS             5
+#define APR_SVC_ADSP_CORE           3
+#define AVCS_CMD_ADSP_EVENT_GET_STATE       0x0001290Cu
+#define AVCS_CMDRSP_ADSP_EVENT_GET_STATE    0x0001290Du
+#define APR_BASIC_RSP_RESULT        0x000110E8u
+
+struct apr_hdr {
+	uint16_t hdr_field, pkt_size;
+	uint8_t  src_svc, src_domain;
+	uint16_t src_port;
+	uint8_t  dest_svc, dest_domain;
+	uint16_t dest_port;
+	uint32_t token, opcode;
+} __attribute__((packed));
+
+static uint32_t apr_state = 0xFFFFFFFFu, apr_asks, apr_rxn, apr_token = 0x100;
+static unsigned apr_last_ask, apr_ready_ms;
+
+static void
+apr_rx(const uint8_t *data, uint32_t len)
+{
+	struct apr_hdr h;
+	if (len < sizeof(h)) {
+		LOG("APR: short packet (%u bytes)", len);
+		return;
+	}
+	memcpy(&h, data, sizeof(h));
+	uint32_t hlen = ((h.hdr_field >> 4) & 0xF) * 4u, p0 = 0, p1 = 0;
+	if (hlen < sizeof(h) || hlen > len) {
+		hlen = sizeof(h);
+	}
+	if (len >= hlen + 4) {
+		memcpy(&p0, data + hlen, 4);
+	}
+	if (len >= hlen + 8) {
+		memcpy(&p1, data + hlen + 4, 4);
+	}
+	if (apr_rxn++ < 16) {
+		LOG("t=%u.%03u APR rx svc %u.%u -> %u.%u opcode %#x token %#x, %u bytes, payload %#x %#x", T,
+		    h.src_domain, h.src_svc, h.dest_domain, h.dest_svc, h.opcode, h.token, len, p0, p1);
+	}
+	if (h.opcode == AVCS_CMDRSP_ADSP_EVENT_GET_STATE) {
+		if (p0 != apr_state) {
+			LOG("t=%u.%03u APR: ADSP state %u", T, p0);
+		}
+		apr_state = p0;
+		if (apr_state == 1 && apr_ready_ms == 0) {
+			apr_ready_ms = ms();
+			LOG("t=%u.%03u *** ADSP APR READY (q6core) ***", T);
+		}
+	}
+}
+
+static bool
+apr_send(uint8_t svc, uint32_t opcode, const void *payload, uint32_t len)
+{
+	uint8_t buf[256];
+	struct apr_hdr h = {};
+	if (APR_HDR_BYTES + len > sizeof(buf)) {
+		return false;
+	}
+	h.hdr_field = APR_HDR_FIELD;
+	h.pkt_size = (uint16_t)(APR_HDR_BYTES + len);
+	h.src_svc = svc;
+	h.src_domain = APR_DOMAIN_APPS;
+	h.dest_svc = svc;
+	h.dest_domain = APR_DOMAIN_ADSP;
+	h.token = apr_token++;
+	h.opcode = opcode;
+	memcpy(buf, &h, sizeof(h));
+	if (len != 0) {
+		memcpy(buf + APR_HDR_BYTES, payload, len);
+	}
+	return glink_send(ACHAN, buf, APR_HDR_BYTES + len);
+}
+
+/* Until the core service says 1: ask once a second (two minutes at most). */
+static void
+apr_poll(void)
+{
+	if (!glink_chan_up(ACHAN) || apr_state == 1 || apr_asks >= 120) {
+		return;
+	}
+	if (apr_asks != 0 && ms() - apr_last_ask < 1000) {
+		return;
+	}
+	apr_last_ask = ms();
+	if (apr_send(APR_SVC_ADSP_CORE, AVCS_CMD_ADSP_EVENT_GET_STATE, NULL, 0) && apr_asks++ < 3) {
+		LOG("t=%u.%03u APR: asked the core service for its state", T);
+	}
+}
+
