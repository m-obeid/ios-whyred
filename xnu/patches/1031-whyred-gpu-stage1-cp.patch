+/* GPU memory layout in the free RAM below the XNU base */
+#define GMEM_PA      0xa0800000u
+#define GMEM_SIZE    0x400000u
+#define ZAP_OFF      0x000000u          /* 1 MiB, the zap segment */
+#define META_OFF     0x100000u          /* zap metadata */
+#define PFP_OFF      0x200000u
+#define PM4_OFF      0x210000u
+#define RING_OFF     0x300000u          /* 32 KiB */
+#define FENCE_OFF    0x310000u          /* rptr shadow at +0, fence at +0x40, test word at +0x80 */
+#define IB_OFF       0x311000u
+#define RING_DW      8192u
+
+#define SMMU_PA      0x05040000
+
 #define RPM_RWCX 0x78637772             /* "rwcx" */
 #define RPM_RWMX 0x786d7772             /* "rwmx" */
 #define RPM_VLVL 0x6c766c76             /* "vlvl" */
 
-static volatile uint8_t *gcc, *gccp, *cc, *gpu, *qf;
+static volatile uint8_t *gcc, *gccp, *cc, *gpu, *qf, *smmu, *gm;
+static uint32_t ring_w;                 /* next ring dword */
+static bool zap_ok;
+static uint32_t pfp_ver, pm4_ver;
+int topaz_fw_read(const char *path, void **data, size_t *size);
+void topaz_fw_free(void *data, size_t size);
