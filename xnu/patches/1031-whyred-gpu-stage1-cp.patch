@@ -77,11 +90,61 @@ void whyred_gpu_init(void);
 #define A5_VBIF_VERSION      0x3000
 #define A5_SECVID_TRUST_CNTL 0xf400
 
+#define A5_CP_RB_BASE        0x800
+#define A5_CP_RB_BASE_HI     0x801
+#define A5_CP_RB_CNTL        0x802
+#define A5_CP_RB_RPTR_ADDR   0x804
+#define A5_CP_RB_RPTR_ADDR_HI 0x805
+#define A5_CP_RB_RPTR        0x806
+#define A5_CP_RB_WPTR        0x807
+#define A5_CP_ROQ_THRESH_1   0x81f
+#define A5_CP_ROQ_THRESH_2   0x820
+#define A5_CP_MEQ_THRESH     0x825
+#define A5_CP_MERCIU_SIZE    0x826
+#define A5_CP_ME_CNTL        0x832
+#define A5_CP_PFP_INSTR_LO   0x835
+#define A5_CP_PFP_INSTR_HI   0x836
+#define A5_CP_PM4_INSTR_LO   0x838
+#define A5_CP_PM4_INSTR_HI   0x839
+#define A5_CP_INT_STATUS     0xb18
