+static inline void
+gwr(uint32_t dw, uint32_t v)
+{
+	wr(gpu, dw * 4, v);
+}
+
+static inline volatile uint32_t *
+gmw(uint32_t off)
+{
+	return (volatile uint32_t *)(gm + off);
+}
+
+static int
+parity(uint32_t v)
+{
+	v ^= v >> 16;
+	v ^= v >> 8;
+	v ^= v >> 4;
+	v &= 0xf;
+	return (~0x6996 >> v) & 1;
+}
+
+static uint32_t
+pkt7(uint32_t op, uint32_t cnt)
+{
+	return (7u << 28) | (cnt & 0x3fff) | ((uint32_t)parity(cnt) << 15) | ((op & 0x7f) << 16) |
+	       ((uint32_t)parity(op) << 23);
+}
+
+static void
+ring_put(uint32_t v)
+{
+	*gmw(RING_OFF + 4 * (ring_w % RING_DW)) = v;
+	ring_w++;
+}
+
+/* ring the doorbell, wait for RPTR to catch up and the GPU to go idle */
+static bool
+ring_kick(const char *what, unsigned ms)
+{
+	__asm__ volatile ("dsb sy" ::: "memory");
+	gwr(A5_CP_RB_WPTR, ring_w % RING_DW);
+	uint32_t rptr = 0, st = 0;
+	for (unsigned i = 0; i < ms * 10; i++) {
+		rptr = grd(A5_CP_RB_RPTR);
+		st = grd(A5_RBBM_STATUS);
+		if (rptr == ring_w % RING_DW && (st & ~1u) == 0) {
+			printf("WHYRED GPU: %s: idle, rptr %u, rbbm status %#x\n", what, rptr, st);
+			return true;
+		}
+		delay(100);
+	}
+	printf("WHYRED GPU: %s: NOT IDLE after %u ms: rptr %u wptr %u status %#x status3 %#x int0 %#x cp_int %#x hw_fault %#x ahb_err %#x\n",
+	    what, ms, rptr, ring_w % RING_DW, st, grd(A5_RBBM_STATUS3), grd(A5_RBBM_INT_0_STATUS), grd(A5_CP_INT_STATUS),
+	    grd(A5_CP_HW_FAULT), grd(A5_RBBM_AHB_ERROR));
+	return false;
+}
+
+static uint32_t smmu_npage, smmu_psize, smmu_nsmr, smmu_ncb;
+
+static bool
+step5(void)
+{
+	say("step 5: reading the GPU SMMU");
+	uint32_t cr0 = rd(smmu, 0x0), id0 = rd(smmu, 0x20), id1 = rd(smmu, 0x24), id2 = rd(smmu, 0x28);
+	smmu_nsmr = id0 & 0xff;
+	smmu_ncb = id1 & 0xff;
+	smmu_psize = (id1 & (1u << 31)) ? 0x10000 : 0x1000;
+	smmu_npage = 1u << (((id1 >> 28) & 7) + 1);
+	printf("WHYRED GPU: smmu sCR0 %#x ID0 %#x ID1 %#x ID2 %#x: %u SMRs, %u CBs, page %#x x%u\n", cr0, id0, id1, id2,
+	    smmu_nsmr, smmu_ncb, smmu_psize, smmu_npage);
+	if ((uint64_t)smmu_npage * smmu_psize * 2 > 0x10000) {
+		printf("WHYRED GPU: smmu layout larger than the 64 KiB mapping\n");
+		return false;
+	}
+	for (uint32_t i = 0; i < smmu_nsmr && i < 32; i++) {
+		printf("WHYRED GPU: smmu SMR%u %#x S2CR %#x\n", i, rd(smmu, 0x800 + 4 * i), rd(smmu, 0xc00 + 4 * i));
+	}
+	volatile uint8_t *gr1 = smmu + smmu_psize, *cb0 = smmu + smmu_npage * smmu_psize;
+	/* banks 2 and up belong to TrustZone (the secure context, SID 2): a read of CB2 stalled the bus */
+	for (uint32_t i = 0; i < smmu_ncb && i < 2; i++) {
+		volatile uint8_t *cb = cb0 + i * smmu_psize;
+		printf("WHYRED GPU: smmu CB%u CBAR %#x CBA2R %#x SCTLR %#x TTBR0 %#x:%#x FSR %#x\n", i, rd(gr1, 4 * i),
+		    rd(gr1, 0x800 + 4 * i), rd(cb, 0x0), rd(cb, 0x24), rd(cb, 0x20), rd(cb, 0x58));
+	}
+	return true;
+}
+
+static bool
+step6(void)
+{
+	/* the SMR that already takes stream 0, else a free one */
+	uint32_t slot = ~0u;
+	for (uint32_t i = 0; i < smmu_nsmr && i < 128; i++) {
+		uint32_t smr = rd(smmu, 0x800 + 4 * i);
+		uint32_t mask = (smr >> 16) & 0x7fff;
+		if ((smr >> 31) && ((smr & 0x7fff) & ~mask) == 0) {
+			slot = i;
+			break;
+		}
+		if (!(smr >> 31) && slot == ~0u) {
+			slot = i;
+		}
+	}
+	uint32_t cb = 0;                        /* Linux kgsl's user context, gpu-offset 0x48000 */
+	if (slot == ~0u) {
+		printf("WHYRED GPU: step 6: no SMR for stream 0\n");
+		return false;
+	}
+	volatile uint8_t *gr1 = smmu + smmu_psize, *cbp = smmu + smmu_npage * smmu_psize + cb * smmu_psize;
+	printf("WHYRED GPU: step 6: identity CB%u at +%#x, SMR%u\n", cb, (uint32_t)(cbp - smmu), slot);
+	/* one log line before each write: the first try stalled somewhere in this block */
+	struct { volatile uint8_t *base; uint32_t off, val; const char *name; } w[] = {
+		{ cbp, 0x58, 0xffffffffu, "CB FSR" },
+		{ cbp, 0x20, 0, "CB TTBR0 lo" },
+		{ cbp, 0x24, 0, "CB TTBR0 hi" },
+		{ cbp, 0x30, 0, "CB TCR" },
+		{ cbp, 0x10, 0, "CB TCR2" },
+		{ cbp, 0x38, 0, "CB MAIR0" },
+		{ cbp, 0x3c, 0, "CB MAIR1" },
+		{ gr1, 0x800 + 4 * cb, 1u, "GR1 CBA2R (VA64)" },
+		{ gr1, 4 * cb, 0x0001f000u, "GR1 CBAR (S1 translate, S2 fault)" },
+		{ cbp, 0x0, 0xe0u, "CB SCTLR (M = 0)" },
+		{ smmu, 0xc00 + 4 * slot, cb, "S2CR (translate to the bank)" },
+		{ smmu, 0x800 + 4 * slot, 1u << 31, "SMR (valid, id 0, mask 0)" },
+	};
+	for (unsigned i = 0; i < sizeof(w) / sizeof(w[0]); i++) {
+		printf("WHYRED GPU: smmu write %s +%#x = %#x\n", w[i].name, (uint32_t)(w[i].base - smmu) + w[i].off, w[i].val);
+		gpu_ms(150);
+		wr(w[i].base, w[i].off, w[i].val);
+	}
+	uint32_t s2cr = rd(smmu, 0xc00 + 4 * slot);
+	printf("WHYRED GPU: CB%u SCTLR %#x CBAR %#x, SMR%u %#x S2CR %#x (type %u cb %u)\n", cb, rd(cbp, 0), rd(gr1, 4 * cb),
+	    slot, rd(smmu, 0x800 + 4 * slot), s2cr, (s2cr >> 16) & 3, s2cr & 0xff);
+	return ((s2cr >> 16) & 3) == 0;
+}
+
+static bool
+step7(void)
+{
+	say("step 7: VBIF, CP thresholds, secure TSB");
+	gwr(A5_VBIF_RR_QOS_ARB, 0x3);
+	gwr(A5_VBIF_GATE_WRREQ, 0x9);
+	gwr(A5_CP_MEQ_THRESH, 0x40);
+	gwr(A5_CP_MERCIU_SIZE, 0x400);
+	gwr(A5_CP_ROQ_THRESH_2, 0x80000060);
+	gwr(A5_CP_ROQ_THRESH_1, 0x40201b16);
+	gwr(A5_SECVID_TSB_CNTL, 0);
+	printf("WHYRED GPU: vbif qos %#x gate %#x, meq %#x merciu %#x roq %#x/%#x, status %#x\n", grd(A5_VBIF_RR_QOS_ARB),
+	    grd(A5_VBIF_GATE_WRREQ), grd(A5_CP_MEQ_THRESH), grd(A5_CP_MERCIU_SIZE), grd(A5_CP_ROQ_THRESH_1),
+	    grd(A5_CP_ROQ_THRESH_2), grd(A5_RBBM_STATUS));
+	return true;
+}
+
+/* copy a firmware file without its first word into GPU memory with 32-bit writes (device memory) */
+static bool
+load_ucode(const char *path, uint32_t off, uint32_t *ver)
+{
+	void *data = NULL;
+	size_t size = 0;
+	int err = topaz_fw_read(path, &data, &size);
+	if (err || size < 8 || (size & 3) || size - 4 > 0x10000) {
+		printf("WHYRED GPU: %s: error %d, %u bytes\n", path, err, (unsigned)size);
+		topaz_fw_free(data, size);
+		return false;
+	}
+	const uint32_t *w = (const uint32_t *)data;
+	for (size_t i = 1; i < size / 4; i++) {
+		*gmw(off + 4 * (uint32_t)(i - 1)) = w[i];
+	}
+	*ver = size > 12 ? w[2] : 0;
+	printf("WHYRED GPU: %s: %u bytes at %#x, words %#x %#x %#x\n", path, (unsigned)size, GMEM_PA + off, w[0], w[1], w[2]);
+	topaz_fw_free(data, size);
+	return true;
+}
+
+static bool
+step8(void)
+{
+	for (int i = 0; i < 600 && !topaz_root_mounted(); i++) {
+		gpu_ms(100);
+	}
+	say("step 8: microcode and ring");
+	if (!load_ucode("/usr/share/firmware/whyred/a530_pfp.fw", PFP_OFF, &pfp_ver) ||
+	    !load_ucode("/usr/share/firmware/whyred/a530_pm4.fw", PM4_OFF, &pm4_ver)) {
+		return false;
+	}
+	for (uint32_t i = 0; i < 0x2000; i += 4) {
+		*gmw(FENCE_OFF + i) = 0;
+	}
+	for (uint32_t i = 0; i < RING_DW; i++) {
+		*gmw(RING_OFF + 4 * i) = 0;
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+	gwr(A5_CP_PFP_INSTR_LO, GMEM_PA + PFP_OFF);
+	gwr(A5_CP_PFP_INSTR_HI, 0);
+	gwr(A5_CP_PM4_INSTR_LO, GMEM_PA + PM4_OFF);
+	gwr(A5_CP_PM4_INSTR_HI, 0);
+	gwr(A5_CP_RB_RPTR_ADDR, GMEM_PA + FENCE_OFF);
+	gwr(A5_CP_RB_RPTR_ADDR_HI, 0);
+	gwr(A5_CP_RB_CNTL, (2u << 8) | 12u);   /* block size 4, ring 4096 quadwords */
+	gwr(A5_CP_RB_BASE, GMEM_PA + RING_OFF);
+	gwr(A5_CP_RB_BASE_HI, 0);
+	ring_w = 0;
+	printf("WHYRED GPU: pfp base %#x pm4 base %#x rb base %#x cntl %#x rptr %u wptr %u me_cntl %#x\n",
+	    grd(A5_CP_PFP_INSTR_LO), grd(A5_CP_PM4_INSTR_LO), grd(A5_CP_RB_BASE), grd(A5_CP_RB_CNTL), grd(A5_CP_RB_RPTR),
+	    grd(A5_CP_RB_WPTR), grd(A5_CP_ME_CNTL));
+	return true;
+}
+
+struct z_ehdr { uint8_t ident[16]; uint16_t type, machine; uint32_t version, entry, phoff, shoff, flags;
+	        uint16_t ehsize, phentsize, phnum, shentsize, shnum, shstrndx; };
+struct z_phdr { uint32_t type, offset, vaddr, paddr, filesz, memsz, flags, align; };
+
+static bool
+step9(void)
+{
+	void *mdt = NULL, *seg = NULL;
+	size_t mdt_size = 0, seg_size = 0;
+	uint64_t st, res = 0;
+	bool ok = false;
+	say("step 9: zap shader through TrustZone (PAS 13)");
+	if (topaz_fw_read("/usr/share/firmware/whyred/a512_zap.mdt", &mdt, &mdt_size) || mdt_size < sizeof(struct z_ehdr)) {
+		printf("WHYRED GPU: a512_zap.mdt not readable\n");
+		goto out;
+	}
+	const struct z_ehdr *eh = (const struct z_ehdr *)mdt;
+	const struct z_phdr *ph = (const struct z_phdr *)((const uint8_t *)mdt + eh->phoff);
+	uint32_t hash = ~0u, load = ~0u;
+	for (uint32_t i = 0; i < eh->phnum && i < 8; i++) {
+		printf("WHYRED GPU: zap phdr %u type %u off %#x paddr %#x filesz %#x memsz %#x flags %#x\n", i, ph[i].type,
+		    ph[i].offset, ph[i].paddr, ph[i].filesz, ph[i].memsz, ph[i].flags);
+		if (((ph[i].flags >> 24) & 7) == 2) {
+			hash = i;
+		}
+		if (ph[i].type == 1 && ph[i].memsz != 0) {
+			load = i;
+		}
+	}
+	if (hash == ~0u || load == ~0u || ph[load].memsz > META_OFF - ZAP_OFF) {
+		printf("WHYRED GPU: zap: hash %u load %u, not usable\n", hash, load);
+		goto out;
+	}
+	uint32_t hsz = eh->phoff + (uint32_t)eh->phnum * sizeof(struct z_phdr);
+	/* the hash segment sits at its file offset in a full ELF, right behind the headers in a split .mdt */
+	uint32_t hoff = ph[hash].offset + ph[hash].filesz <= mdt_size ? ph[hash].offset : hsz;
+	if (hoff + ph[hash].filesz > mdt_size || hsz + ph[hash].filesz > 0x10000) {
+		printf("WHYRED GPU: zap: hash segment outside the .mdt\n");
+		goto out;
+	}
+	const uint8_t *m = (const uint8_t *)mdt;
+	for (uint32_t i = 0; i < hsz; i += 4) {
+		*gmw(META_OFF + i) = *(const uint32_t *)(m + i);
+	}
+	for (uint32_t i = 0; i < ph[hash].filesz; i += 4) {
+		*gmw(META_OFF + hsz + i) = *(const uint32_t *)(m + hoff + i);
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+	st = topaz_scm(0x42000201u, 2 | (2u << 6), 13, GMEM_PA + META_OFF, 0, &res);   /* PIL INIT_IMAGE, arg 2 RW */
+	printf("WHYRED GPU: PAS 13 init_image: ret %#llx res %#llx\n", st, res);
+	if (st != 0 || res != 0) {
+		goto out;
+	}
+	st = topaz_scm(0x42000202u, 3, 13, GMEM_PA + ZAP_OFF, (ph[load].memsz + 0xfff) & ~0xfffu, &res);   /* MEM_SETUP */
+	printf("WHYRED GPU: PAS 13 mem_setup %#x+%#x: ret %#llx res %#llx\n", GMEM_PA + ZAP_OFF, ph[load].memsz, st, res);
+	if (st != 0 || res != 0) {
+		goto shutdown;
+	}
+	if (topaz_fw_read("/usr/share/firmware/whyred/a512_zap.b02", &seg, &seg_size) || seg_size != ph[load].filesz) {
+		printf("WHYRED GPU: a512_zap.b02 not readable or %u bytes (want %#x)\n", (unsigned)seg_size, ph[load].filesz);
+		goto shutdown;
+	}
+	for (uint32_t i = 0; i < ph[load].memsz; i += 4) {
+		*gmw(ZAP_OFF + i) = i + 4 <= seg_size ? *(const uint32_t *)((const uint8_t *)seg + i) : 0;
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+	st = topaz_scm(0x42000205u, 1, 13, 0, 0, &res);         /* AUTH_AND_RESET */
+	printf("WHYRED GPU: PAS 13 auth_and_reset: ret %#llx res %#llx\n", st, res);
+	ok = st == 0 && res == 0;
+	if (ok) {
+		goto out;
+	}
+shutdown:
+	st = topaz_scm(0x42000206u, 1, 13, 0, 0, &res);         /* SHUTDOWN */
+	printf("WHYRED GPU: PAS 13 shutdown after failure: ret %#llx res %#llx\n", st, res);
+out:
+	topaz_fw_free(mdt, mdt_size);
+	topaz_fw_free(seg, seg_size);
+	zap_ok = ok;
+	printf("WHYRED GPU: zap %s, secvid trust cntl %#x\n", ok ? "loaded" : "NOT loaded", grd(A5_SECVID_TRUST_CNTL));
+	return true;                            /* step 10 falls back to the register without a zap */
+}
+
+static bool
+step10(void)
+{
+	say("step 10: CP start, CP_ME_INIT");
+	gwr(A5_CP_ME_CNTL, 0);
+	ring_put(pkt7(PKT_ME_INIT, 8));
+	ring_put(0x2f);
+	ring_put(0x3);
+	ring_put(0x20000000);
+	for (int i = 0; i < 5; i++) {
+		ring_put(0);
+	}
+	if (!ring_kick("CP_ME_INIT", 2000)) {
+		return false;
+	}
+	if (zap_ok) {
+		ring_put(pkt7(PKT_SET_SECURE_MODE, 1));
+		ring_put(0);
+		if (!ring_kick("CP_SET_SECURE_MODE 0", 2000)) {
+			return false;
+		}
+	} else {
+		say("step 10: no zap, writing SECVID_TRUST_CNTL 0");
+		gwr(A5_SECVID_TRUST_CNTL, 0);
+	}
+	printf("WHYRED GPU: secvid trust cntl %#x\n", grd(A5_SECVID_TRUST_CNTL));
+	return true;
+}
+
+static bool
+step11(void)
+{
+	say("step 11: job test (indirect buffer with CP_MEM_WRITE, then CACHE_FLUSH_TS)");
+	uint32_t test_pa = GMEM_PA + FENCE_OFF + 0x80, fence_pa = GMEM_PA + FENCE_OFF + 0x40;
+	*gmw(FENCE_OFF + 0x80) = 0;
