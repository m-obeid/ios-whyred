+#define PKT_SET_SECURE_MODE  0x66
+#define PKT_MEM_WRITE        0x3d
+#define PKT_EVENT_WRITE      0x46
+#define PKT_IB_PFE           0x3f
+#define PKT_WAIT_FOR_IDLE    0x26
+#define EV_CACHE_FLUSH_TS    4
