 void
+AppleCLCD::wledOffWork(thread_call_param_t p0, __unused thread_call_param_t p1)
+{
+	AppleCLCD *fb = (AppleCLCD *)p0;
+	IOLockLock(fb->fLock);
+	bool off = fb->fPowerOff;
+	IOLockUnlock(fb->fLock);
+	if (!off) {
+		return;                 /* turned back on during the fade */
+	}
+	IOLockLock(fb->fBlLock);
+	int r = fb->fWledOff ? 0 : sweet_wled_enable(0);
+	fb->fWledOff = true;
+	IOLockUnlock(fb->fBlLock);
+	IOLog("SWEET FB: WLED off after fade: %s\n", r == 0 ? "done" : "FAILED");
+}
