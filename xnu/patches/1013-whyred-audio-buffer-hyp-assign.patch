+#define VMID_HLOS                       3
+#define VMID_LPASS                      6       /* Linux techpack/audio msm_mdf.c */
 
 /*
  * SMMUv2 global space: sCR0, IDR0 (number of SMRs), SMR (0x800 + 4n) / S2CR (0xC00 + 4n). Nothing matches
@@ -2263,6 +2266,18 @@ spk_tone(unsigned seconds)
 	}
 	mb();
 	LOG("stream: buffer %u bytes at pa %#llx", TONE_BUF_BYTES, pa);
+	/*
+	 * DDR outside the carve-outs belongs to HLOS; the ADSP's first read of an unshared buffer reset the
+	 * SoC (1008-1012, silently, also with the amplifier off). Share it with LPASS, as msm_mdf does.
+	 */
+	{
+		static const uint32_t vm[2] = { VMID_HLOS, VMID_LPASS };
+		uint64_t ar = topaz_scm_assign(pa, TONE_MAP_BYTES, vm, 2);
+		LOG("stream: buffer shared with HLOS + LPASS (hyp_assign): %#llx", ar);
+		if (ar != 0) {
+			return false;
+		}
+	}
 	IOSleep(1500);
 
 	bzero(p, sizeof(p));
