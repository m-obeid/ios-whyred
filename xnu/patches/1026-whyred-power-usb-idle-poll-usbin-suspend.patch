 }
 
+/*
+ * kern.whyred_usbin_suspend (root): write N (1-900) to run on the battery for N seconds with the cable in,
+ * 0 to charge again at once; read: seconds left. Ends by itself (SweetBattery's 1 s timer), so a lost
+ * session never leaves the phone without charge. Cleared once at boot too.
+ */
+static uint64_t usbin_until;            /* mach_absolute_time(); 0 = charging normally */
+static bool usbin_cleared;
+
+static int
+usbin_suspend(bool on)
+{
+	uint8_t v;
+	if (whyred_spmi_init() != 0 || whyred_spmi_read(0, 0x1340, &v) != 0) {
+		return -1;
+	}
+	v = on ? (uint8_t)(v | 1u) : (uint8_t)(v & ~1u);
+	int r = whyred_spmi_write(0, 0x1340, v);
+	uint8_t back = 0xff;
+	(void)whyred_spmi_read(0, 0x1340, &back);
+	printf("WHYRED USBIN: suspend %d: %s, USBIN_CMD_IL %#x\n", on, r == 0 ? "ok" : "FAILED", back);
+	return r;
+}
+
+static void
+usbin_tick(void)
+{
+	if (!usbin_cleared) {
+		usbin_cleared = true;
+		(void)usbin_suspend(false);
+	}
+	if (usbin_until != 0 && mach_absolute_time() >= usbin_until) {
+		usbin_until = 0;
+		(void)usbin_suspend(false);
+	}
+}
+
+static int
+sysctl_whyred_usbin SYSCTL_HANDLER_ARGS
+{
+#pragma unused(oidp, arg1, arg2)
+	uint64_t now = mach_absolute_time(), left_ns = 0;
+	if (usbin_until > now) {
+		absolutetime_to_nanoseconds(usbin_until - now, &left_ns);
+	}
+	int v = (int)(left_ns / NSEC_PER_SEC), err = sysctl_handle_int(oidp, &v, 0, req);
+	if (err || req->newptr == USER_ADDR_NULL) {
+		return err;
+	}
+	if (v < 0 || v > 900) {
+		return EINVAL;
+	}
+	if (v == 0) {
+		usbin_until = 0;
+		return usbin_suspend(false) == 0 ? 0 : EIO;
+	}
+	uint64_t span;
+	nanoseconds_to_absolutetime((uint64_t)v * NSEC_PER_SEC, &span);
+	if (usbin_suspend(true) != 0) {
+		return EIO;
+	}
+	usbin_until = now + span;
+	return 0;
+}
+
+SYSCTL_PROC(_kern, OID_AUTO, whyred_usbin_suspend, CTLTYPE_INT | CTLFLAG_RW | CTLFLAG_LOCKED, NULL, 0,
+    sysctl_whyred_usbin, "I", "whyred: seconds on the battery with the cable in");
+
 void
 whyred_rtc_set_clock(void)
 {
 	static bool parsed;
 	static int64_t off = -1;
 	whyred_root_watchdog();
+	usbin_tick();
 	if (!parsed) {
 		parsed = true;
 		if (!PE_parse_boot_argn("whyred_rtcoff", &off, sizeof(off))) {
@@ -695,8 +770,8 @@ sysctl_whyred_torch SYSCTL_HANDLER_ARGS
 /*
  * kern.whyred_codec (root): one register access for bring-up of the microphone. Write a command:
  *   bits 31-28 op: 1 PM660L SPMI read, 2 SPMI write (SID 3 0xf000-0xf1ff), 3 digital codec read,
- *   4 digital codec write, 5 LPI TLMM read, 6 LPI TLMM write (both only while /dev/redwood-mic is open);
- *   bits 27-8 register, bits 7-0 value. Read: the result of the last command (-1 = failed).
+ *   4 digital codec write, 5 LPI TLMM read, 6 LPI TLMM write (both only while /dev/redwood-mic is open),
+ *   7 SPMI read of any SID (register bits 27-24 SID, 23-8 address); bits 27-8 register, bits 7-0 value. Read: the result of the last command (-1 = failed).
  */
 int whyred_mic_mmio(int lpi, int write, unsigned off, uint32_t *val);
 static int codec_last = -1;
@@ -716,6 +791,7 @@ sysctl_whyred_codec SYSCTL_HANDLER_ARGS
 	switch (op) {
 	case 1: r = whyred_spmi_read(3, reg, &b) == 0 ? b : -1; break;
 	case 2: r = whyred_spmi_write(3, reg, b) == 0 && whyred_spmi_read(3, reg, &b) == 0 ? b : -1; break;
+	case 7: r = whyred_spmi_init() == 0 && whyred_spmi_read(reg >> 16, reg & 0xffffu, &b) == 0 ? b : -1; break;
 	case 3: case 4: case 5: case 6:
 		r = whyred_mic_mmio(op >= 5, op == 4 || op == 6, reg, &w) == 0 ? (int)w : -1;
