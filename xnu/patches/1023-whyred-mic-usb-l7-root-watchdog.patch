@@ -282,11 +282,38 @@ SYSCTL_PROC(_kern, OID_AUTO, whyred_rtc, CTLTYPE_QUAD | CTLFLAG_RD | CTLFLAG_LOC
  * no longer saves 1970 dates; the launchd job started too late for that (2026-11-23).
  */
 void whyred_rtc_set_clock(void);
+extern struct vnode *rootvnode;
+extern int (*PE_halt_restart)(unsigned int type);
+extern void IOSleep(unsigned milliseconds);
+
+/* no root file system 120 s after boot (a bad image): reset, which boots Android's Linux, not a stranded phone */
+static void
+whyred_root_watchdog(void)
+{
+	static bool done;
+	if (done) {
+		return;
+	}
+	if (rootvnode != NULL) {
+		done = true;
+		return;
+	}
+	clock_sec_t s;
+	clock_usec_t us;
+	clock_get_system_microtime(&s, &us);
+	if (s >= 120 && PE_halt_restart != NULL) {
+		printf("WHYRED: root not mounted after %lu s, resetting\n", (unsigned long)s);
+		IOSleep(500);
+		(void)PE_halt_restart(1);       /* kPERestartCPU */
+	}
+}
+
 void
 whyred_rtc_set_clock(void)
 {
 	static bool parsed;
 	static int64_t off = -1;
+	whyred_root_watchdog();
 	if (!parsed) {
 		parsed = true;
 		if (!PE_parse_boot_argn("whyred_rtcoff", &off, sizeof(off))) {
