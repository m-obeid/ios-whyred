+/* Emulated LSE ops in the last interval, by op, and the four hottest PCs overall. */
+static void
+lse_report(unsigned secs)
+{
+	static uint64_t last[11];
+	static const char *const names[11] = {
+		"add", "clr", "eor", "set", "smax", "smin", "umax", "umin", "swp", "cas", "ldapr",
+	};
+	uint64_t total = 0;
+	char line[200];
+	int len = 0;
+	for (int i = 0; i < 11; i++) {
+		uint64_t n = sweet_lse_ops[i], d = n - last[i];
+		last[i] = n;
+		total += d;
+		if (d != 0 && len < (int)sizeof(line) - 24) {
+			len += snprintf(line + len, sizeof(line) - (size_t)len, " %s %llu", names[i], d / secs);
+		}
+	}
+	line[len] = 0;
+	printf("WHYRED LSE: %llu/s:%s\n", total / secs, line);
+	struct sweet_lse_site top[4] = {};
+	for (int i = 0; i < 64; i++) {
+		struct sweet_lse_site s = sweet_lse_sites[i];
+		for (int j = 0; j < 4; j++) {
+			if (s.n > top[j].n) {
+				for (int k = 3; k > j; k--) {
+					top[k] = top[k - 1];
+				}
+				top[j] = s;
+				break;
+			}
+		}
+	}
+	printf("WHYRED LSE top: %#llx %llu, %#llx %llu, %#llx %llu, %#llx %llu\n",
+	    top[0].pc, top[0].n, top[1].pc, top[1].n, top[2].pc, top[2].n, top[3].pc, top[3].n);
+}
