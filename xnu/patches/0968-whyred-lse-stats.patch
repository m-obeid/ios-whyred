diff --git a/osfmk/arm64/sleh.c b/osfmk/arm64/sleh.c
--- a/osfmk/arm64/sleh.c
+++ b/osfmk/arm64/sleh.c
@@ -888,6 +888,48 @@
  * (machine_routines_asm.s); returns false for anything else (CASP stays
  * EXC_BAD_INSTRUCTION).
  */
+/*
+ * whyred: emulation statistics for bsd/dev/sweet_thermal.c (sweettherm=2 logs them every 10 s).
+ * Per-op counts and a 64-slot table of the hottest user PCs. Shared cache PCs are stored unslid,
+ * other PCs with bit 63 set. Updates are racy across CPUs; the numbers are approximate.
+ */
+#include <vm/vm_shared_region.h>
+struct sweet_lse_site {
+	uint64_t pc, n;
+};
+extern uint64_t sweet_lse_ops[11];
+extern struct sweet_lse_site sweet_lse_sites[64];
+uint64_t sweet_lse_ops[11];
+struct sweet_lse_site sweet_lse_sites[64];
+static uint64_t sweet_lse_slide, sweet_lse_sr_lo, sweet_lse_sr_hi;
+static bool sweet_lse_sr_known;
+
+static void
+sweet_lse_account(uint32_t op, uint64_t pc)
+{
+	sweet_lse_ops[op]++;
+	if (!sweet_lse_sr_known) {
+		vm_shared_region_t sr = vm_shared_region_get(current_task());
+		if (sr != NULL) {
+			sweet_lse_slide = sr->sr_slide;
+			sweet_lse_sr_lo = sr->sr_base_address;
+			sweet_lse_sr_hi = sr->sr_base_address + sr->sr_size;
+			sweet_lse_sr_known = true;
+			vm_shared_region_deallocate(sr);
+		}
+	}
+	uint64_t key = (pc >= sweet_lse_sr_lo && pc < sweet_lse_sr_hi) ? pc - sweet_lse_slide : pc | (1ULL << 63);
+	struct sweet_lse_site *s = &sweet_lse_sites[(key >> 2) & 63];
+	if (s->pc == key) {
+		s->n++;
+	} else if (s->n == 0) {
+		s->pc = key;
+		s->n = 1;
+	} else {
+		s->n--;                 /* a hotter PC wins the slot over time */
+	}
+}
+
 static bool
 sweet_emulate_lse(arm_saved_state_t *state, uint32_t instr)
 {
@@ -942,6 +984,7 @@
 	if (dst != 31) {
 		set_saved_state_reg(state, dst, (register_t)old);
 	}
+	sweet_lse_account(op, get_saved_state_pc(state));
 	add_saved_state_pc(state, 4);
 	return true;
 }
