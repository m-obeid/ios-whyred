+			*va = (volatile uint32_t *)(base + off);
+			return p;
 		}
-		tried[n++] = m;
 	}
-	for (unsigned i = 0; i < n; i++) {
-		tried[i]->release();
-	}
-	return pa;
+	return 0;
 }
 
