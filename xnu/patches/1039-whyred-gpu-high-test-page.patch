 	*va = NULL;
-	while (n < 32) {
-		IOBufferMemoryDescriptor *m = IOBufferMemoryDescriptor::inTaskWithPhysicalMask(kernel_task,
-		    kIODirectionInOut | kIOMemoryPhysicallyContiguous | kIOMapWriteCombineCache, 4096, 0x0000000ffffff000ull);
-		if (m == NULL) {
-			break;
