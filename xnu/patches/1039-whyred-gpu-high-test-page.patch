 /*
- * For whyred_gpu.c's high test: one write-combined page above 4 GiB. Pages are taken until one lies there
- * (XNU's RAM is 0xb2000000 + 0xcc000000, most of it above 4 GiB); the others go back.
+ * For whyred_gpu.c's high test: one page above 4 GiB. One-page allocations all came from below 4 GiB (1038), so a
+ * 16 MiB buffer of loose pages is taken and the first of its pages above 4 GiB used. Cached memory: the caller
+ * cleans the page before the GPU writes and invalidates it before reading (sweet_dcache_flush).
  */
 static IOBufferMemoryDescriptor *high_page;
 
 uint64_t
 whyred_high_page(volatile uint32_t **va)
 {
-	IOBufferMemoryDescriptor *tried[32];
-	unsigned n = 0;
-	uint64_t pa = 0;
