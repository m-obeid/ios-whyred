-		uint64_t p = m->getPhysicalSegment(0, NULL, kIOMemoryMapperNone);
+	high_page = IOBufferMemoryDescriptor::inTaskWithOptions(kernel_task, kIODirectionInOut, size, 4096);
+	if (high_page == NULL) {
