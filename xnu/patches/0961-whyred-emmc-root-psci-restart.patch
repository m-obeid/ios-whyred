--- a/iokit/Kernel/arm/SweetPlatformExpert.cpp
+++ b/iokit/Kernel/arm/SweetPlatformExpert.cpp
@@ -9,6 +9,57 @@
 #include <IOKit/IOPlatformExpert.h>
 #include <IOKit/IODeviceTreeSupport.h>
 #include <IOKit/IOLib.h>
+#include <kern/clock.h>
+#include <pexpert/pexpert.h>
+
+/*
+ * whyred: XNU had no way to reset the board. IOPlatformExpert::haltRestart calls
+ * PE_halt_restart for every reboot type, so point it at PSCI. A panic halts with its
+ * message on screen, and resets after panicreset=<seconds> if that boot-arg is set.
+ */
+extern "C" int (*PE_halt_restart)(unsigned int type);
+
+#define SWEET_PSCI_SYSTEM_OFF   0x84000008ULL
+#define SWEET_PSCI_SYSTEM_RESET 0x84000009ULL
+
+static uint32_t sweet_panic_reset_s;
+
+static void __attribute__((noreturn))
+sweet_psci_call(uint64_t fn)
+{
+	register uint64_t x0 __asm__("x0") = fn;
+	__asm__ volatile("smc #0" : "+r"(x0) : : "x1", "x2", "x3", "memory");
+	for (;;) {
+		__asm__ volatile("wfe");
+	}
+}
+
+static int
+sweet_halt_restart(unsigned int type)
+{
+	switch (type) {
+	case kPERestartCPU:
+		sweet_psci_call(SWEET_PSCI_SYSTEM_RESET);
+	case kPEHaltCPU:
+		sweet_psci_call(SWEET_PSCI_SYSTEM_OFF);
+	case kPEPanicRestartCPU:
+	case kPEPanicRestartCPUNoCallouts:
+		if (sweet_panic_reset_s == 0) {
+			for (;;) {
+				__asm__ volatile("wfe");
+			}
+		}
+		/* Interrupts may be off: count the generic timer directly. */
+		{
+			uint64_t end = mach_absolute_time() + (uint64_t)sweet_panic_reset_s * 19200000ULL;
+			while (mach_absolute_time() < end) {
+			}
+		}
+		sweet_psci_call(SWEET_PSCI_SYSTEM_RESET);
+	default:
+		return 0;
+	}
+}
 
