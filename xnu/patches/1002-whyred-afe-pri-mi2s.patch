+/*
+ * One APR command to service svc, pumping GLINK until the reply with its token. The result: the status
+ * of APR_BASIC_RSP_RESULT (0 = done), 0 for any other reply, -1 when nothing came.
+ */
+static int
+apr_call(uint8_t svc, uint32_t opcode, const void *payload, uint32_t len, unsigned timeout_ms)
+{
+	apr_call_done = false;
+	apr_call_token = apr_token;             /* (apr_send uses this token next) */
+	if (!apr_send(svc, opcode, payload, len)) {
+		apr_call_token = 0;
+		LOG("APR %#x: send failed", opcode);
+		return -1;
+	}
+	for (unsigned t = ms(); !apr_call_done && ms() - t < timeout_ms;) {
+		if (!glink_poll()) {
+			IOSleep(1);
+		}
+	}
+	apr_call_token = 0;
+	if (!apr_call_done) {
+		LOG("APR %#x: no reply", opcode);
+		return -1;
+	}
+	if (apr_call_op == APR_BASIC_RSP_RESULT) {
+		return (int)apr_call_p1;        /* payload: opcode, status */
+	}
+	return 0;
+}
