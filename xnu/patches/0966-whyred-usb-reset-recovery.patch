 /*
+ * USB reset or disconnect (Linux dwc3_gadget_reset_interrupt / dwc3_disconnect_gadget): end
+ * every active transfer, drop the configuration and queued frames, and restart ep0 with a fresh
+ * SETUP. Without this an unplug in mid control transfer left ep0 without a SETUP buffer and the
+ * next host's SET_ADDRESS went unanswered.
+ */
+static void
+ud_bus_reset(bool clear_address)
+{
+	ud_end(EP_RX);
+	ud_end(EP_TX);
+	ud_end(EP_INT);
+	dwc_wr(DALEPENA, dwc_rd(DALEPENA) & ~((1u << EP_RX) | (1u << EP_TX) | (1u << EP_INT)));
+	lck_mtx_lock(ud.lock);
+	ud.configured = false;
+	ud.tx_busy = false;
+	while (ud.txq_count > 0) {
+		mbuf_freem(ud.txq[ud.txq_head]);
+		ud.txq_head = (ud.txq_head + 1) % UD_TXQ;
+		ud.txq_count--;
+	}
+	lck_mtx_unlock(ud.lock);
+	if (clear_address) {
+		dwc_wr(DCFG, dwc_rd(DCFG) & ~(0x7fu << 3));
+	}
+	if (ud.state != EP0_SETUP || !(ud.active & 1u)) {
+		ud_end(1);
+		ud_end(0);
+		ud_stall();             /* stall and re-arm SETUP, as dwc3_ep0_stall_and_restart */
+	}
+}
