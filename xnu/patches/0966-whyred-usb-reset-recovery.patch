+/* End the active transfer on ep (Linux dwc3_stop_active_transfer, ForceRM). */
+static void
+ud_end(unsigned ep)
+{
+	if (!(ud.active & (1u << ep))) {
+		return;
+	}
+	(void)ud_epcmd(ep, DEPCMD_ENDTRANSFER | DEPCMD_FORCERM | ((uint32_t)ud.res[ep & 7] << 16), 0, 0, 0);
+	ud.active &= ~(1u << ep);
 }
 
