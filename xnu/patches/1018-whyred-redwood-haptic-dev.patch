 		gpr_poll();                             /* (returns at once: GCHAN is not up) */
 		if (apr_state == 1 && !afe_tried) {
 			afe_tried = true;
+			whyred_haptic_dev_init();       /* the plug-in's Actuator output (bsd/dev/whyred_spmi.c) */
 			afe_up = afe_bringup();
 			LOG("t=%u.%03u *** AFE speaker port %s ***", T, afe_up ? "RUNNING" : "failed");
 			if (tas_probe()) {
