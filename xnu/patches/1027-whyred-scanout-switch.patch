 	/* whyred qcom,mdss-intf-off <0x6b000 0x6b800 ...>: INTF_1 (DSI0) at 0xc96b800, the same +0x800 */
 	fIntf1 = (volatile uint32_t *)ml_io_map(0x0c96b000, 0x1000);
 	if (fIntf1 != NULL) {
