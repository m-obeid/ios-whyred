+
+/*
+ * whyred: the MDP's INTF_1 timing engine (INTF_TIMING_ENGINE_EN, INTF base + 0) scans the frame out to the
+ * video-mode panel 60 times a second, also while the WLED is off. 0 stops it (the DSI lanes idle), 1 starts
+ * it again with the same timing and layer. on < 0: only report. Returns the engine bit, -1 without INTF_1.
+ */
+extern "C" int
+sweet_fb_scanout(int on)
+{
+	AppleCLCD *fb = sweet_fb_instance;
+	if (fb == NULL || fb->fIntf1 == NULL) {
+		return -1;
+	}
+	volatile uint32_t *r = fb->fIntf1 + 0x800 / 4;
+	if (on >= 0 && (r[0] & 1u) != (unsigned)(on != 0)) {
+		__asm__ volatile ("dsb sy" ::: "memory");
+		r[0] = on ? 1u : 0u;
+		__asm__ volatile ("dsb sy" ::: "memory");
+		fb->fTeOff = on == 0;
+		IOLog("SWEET FB: scanout %s (te_en %#x, frame %u)\n", on ? "on" : "off", r[0], r[0x0ac / 4]);
+	}
+	return (int)(r[0] & 1u);
+}
