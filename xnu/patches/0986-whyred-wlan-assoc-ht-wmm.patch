+/* the AP's beacon has a WMM parameter/info element (vendor 00:50:F2, type 2) */
+static bool
+w_has_wmm(void)
+{
+	for (uint32_t o = 0; o + 2 <= s_body_len && o + 2 + s_body[o + 1] <= s_body_len; o += 2 + s_body[o + 1]) {
+		if (s_body[o] == 221 && s_body[o + 1] >= 5 && s_body[o + 2] == 0x00 && s_body[o + 3] == 0x50 &&
+		    s_body[o + 4] == 0xF2 && s_body[o + 5] == 0x02) {
+			return true;
+		}
+	}
+	return false;
+}
