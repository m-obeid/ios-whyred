+/*
+ * whyred: PM660 (SID 0) FG gen3 and SMB2 charger, read only, as Linux qpnp-fg-gen3 / fg-util.c
+ * and qpnp-smb2 read them. Each 2-byte value is read with its shadow copy and used only when
+ * both match.
+ *   0x4009/0x400a  BATT_SOC_FG_MONOTONIC_SOC (+ CP): 0..255
+ *   0x41a0/0x41a6  BATT_INFO_VBATT (+ CP): 122.07 uV per bit
+ *   0x41a2/0x41a8  BATT_INFO_IBATT (+ CP): signed, 488.28 uA per bit, positive = charging
+ *                  (Linux bms current_now +381835 uA while charging, 2026-11-10)
+ *   0x4150         BATT_INFO_BATT_TEMP: 10 bits, quarter Kelvin
+ *   0x1006 [2:0]   BATTERY_CHARGER_STATUS_1: trickle, pre, fast, full-on, taper, terminate, ...
+ *   0x1310 bit 4   USBIN_PLUGIN_RT_STS
+ */
+bool
+SweetBattery::whyredPair(unsigned a, unsigned b, uint16_t *value)
+{
+	for (unsigned tries = 0; tries < 5; tries++) {
+		uint8_t l0, h0, l1, h1;
+		if (whyred_spmi_read(0, a, &l0) || whyred_spmi_read(0, a + 1, &h0) ||
+		    whyred_spmi_read(0, b, &l1) || whyred_spmi_read(0, b + 1, &h1)) {
+			return false;
+		}
+		if (l0 == l1 && h0 == h1) {
+			*value = (uint16_t)(l0 | h0 << 8);
+			return true;
+		}
+	}
+	return false;
+}
+
+bool
+SweetBattery::pollWhyred(void)
+{
+	uint8_t soc = 0, soc_cp = 1, tl, th, chg, usb;
+	for (unsigned tries = 0; tries < 5 && soc != soc_cp; tries++) {
+		if (whyred_spmi_read(0, 0x4009, &soc) || whyred_spmi_read(0, 0x400a, &soc_cp)) {
+			return false;
+		}
+	}
+	uint16_t rv, ri;
+	if (soc != soc_cp || !whyredPair(0x41a0, 0x41a6, &rv) || !whyredPair(0x41a2, 0x41a8, &ri) ||
+	    whyred_spmi_read(0, 0x4150, &tl) || whyred_spmi_read(0, 0x4151, &th) ||
+	    whyred_spmi_read(0, 0x1006, &chg) || whyred_spmi_read(0, 0x1310, &usb)) {
+		return false;
+	}
+	/* fg_get_msoc: 0 and 255 exact, 1..254 scaled to 1..99 */
+	unsigned percent = soc == 255 ? 100 : soc == 0 ? 0 : (((unsigned)soc - 1) * 98u + 126u) / 253u + 1u;
+	unsigned mv = (unsigned)(((uint64_t)rv * 122070u) / 1000000u);
+	int ua = (int)(((int64_t)(int16_t)ri * 488281) / 1000);
+	int ma = ua / 1000;                     /* IOPMPowerSource: positive = charging, as the gauge */
+	int kq = ((th & 7) << 8) | tl;          /* quarter Kelvin */
+	int deci = ((kq + 2) / 4 - 273) * 10;
+	if (mv < 2800 || mv > 4600 || deci < -400 || deci > 900) {
+		return false;
+	}
+	fTempCenti = deci * 10;
+	fTempMeasured = true;
+	unsigned state = chg & 7u;
+	bool external = (usb & 0x10u) != 0;
+	bool charging = external && state <= 4;
+	bool full = external && state == 5;
+	publish(full ? 100 : percent, mv, ma, external, external, charging, full, true, true);
+	static unsigned logs;
+	if (logs++ % 30 == 0) {
+		IOLog("SWEET BATTERY: whyred %u%% (raw %u) %umV %dmA %d.%dC charger state %u usb %d\n",
+		    percent, soc, mv, ma, deci / 10, (deci < 0 ? -deci : deci) % 10, state, external);
+	}
+	return true;
+}
