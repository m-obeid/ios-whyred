diff --git a/bsd/dev/whyred_spmi.c b/bsd/dev/whyred_spmi.c
new file mode 100644
--- /dev/null
+++ b/bsd/dev/whyred_spmi.c
@@ -0,0 +1,120 @@
+/*
+ * whyred: read-only PMIC register access over the SPMI arbiter v3 (live DT qcom,spmi@800f000:
+ * core 0x800f000, obsrvr 0x9400000, cnfg 0x800a000, EE 0). One observer channel per APID at
+ * obsrvr + 0x8000 * apid; EXT_READL of one byte, as sweet_keys.c. No writes.
+ * Used by SweetBattery (sweetbattery=2) for the PM660 fuel gauge and charger status.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <machine/machine_routines.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+int whyred_spmi_init(void);
+int whyred_spmi_read(unsigned sid, unsigned addr, uint8_t *out);
+
+#define WS_CORE_PA      0x0800f000u
+#define WS_OBS_PA       0x09400000u
+#define WS_CNFG_PA      0x0800a000u
+#define WS_APIDS        512u
+#define WS_SLOTS        8u
+
+static vm_offset_t ws_core, ws_cnfg;
+static bool ws_ready, ws_tried;
+static struct {
+	uint16_t ppid;
+	vm_offset_t ch;         /* observer channel; 0 = no apps-owned APID */
+} ws_slot[WS_SLOTS];
+static unsigned ws_used;
+
+static uint32_t
+ws_rd(vm_offset_t b, uint32_t o)
+{
+	uint32_t v = *(volatile uint32_t *)(b + o);
+	__asm__ volatile ("dmb oshld" ::: "memory");
+	return v;
+}
+
+int
+whyred_spmi_init(void)
+{
+	if (ws_tried) {
+		return ws_ready ? 0 : -1;
+	}
+	ws_tried = true;
+	ws_core = ml_io_map(WS_CORE_PA, 0x1000);
+	ws_cnfg = ml_io_map(WS_CNFG_PA, 0x1000);
+	if (!ws_core || !ws_cnfg) {
+		return -1;
+	}
+	uint32_t ver = ws_rd(ws_core, 0);
+	if (ver < 0x30000000u || ver >= 0x40000000u) {
+		printf("WHYRED SPMI: arbiter version %#x is not v3\n", ver);
+		return -1;
+	}
+	ws_ready = true;
+	return 0;
+}
+
+/* Observer channel of the apps-owned APID for a PPID, mapped once and cached. */
+static vm_offset_t
+ws_channel(uint16_t ppid)
+{
+	for (unsigned i = 0; i < ws_used; i++) {
+		if (ws_slot[i].ppid == ppid) {
+			return ws_slot[i].ch;
+		}
+	}
+	if (ws_used == WS_SLOTS) {
+		return 0;
+	}
+	uint32_t found = WS_APIDS;
+	for (uint32_t a = 0; a < WS_APIDS; a++) {
+		uint32_t map = ws_rd(ws_core, 0x800u + 4u * a);
+		if (map == 0 || ((map >> 8) & 0xfffu) != ppid) {
+			continue;
+		}
+		if ((ws_rd(ws_cnfg, 0x700u + 4u * a) & 7u) == 0) {
+			found = a;
+			break;
+		}
+		if (found == WS_APIDS) {
+			found = a;
+		}
+	}
+	vm_offset_t ch = found == WS_APIDS ? 0 : ml_io_map(WS_OBS_PA + 0x8000u * found, 0x1000);
+	ws_slot[ws_used].ppid = ppid;
+	ws_slot[ws_used].ch = ch;
+	ws_used++;
+	printf("WHYRED SPMI: ppid %#x -> apid %u\n", ppid, found);
+	return ch;
+}
+
+/* One byte at PMIC sid, 16-bit address addr. 0 on success. Callers are serialized (one work loop). */
+int
+whyred_spmi_read(unsigned sid, unsigned addr, uint8_t *out)
+{
+	if (!ws_ready) {
+		return -1;
+	}
+	vm_offset_t ch = ws_channel((uint16_t)((sid & 0xfu) << 8 | ((addr >> 8) & 0xffu)));
+	if (!ch) {
+		return -1;
+	}
+	__asm__ volatile ("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)ch = (1u << 27) | ((addr & 0xffu) << 4);     /* EXT_READL, 1 byte */
+	__asm__ volatile ("dsb osh" ::: "memory");
+	for (unsigned i = 0; i < 1000; i++) {
+		uint32_t st = ws_rd(ch, 0x08);
+		if (st & 1u) {
+			if (st & 0x0eu) {
+				return -1;
+			}
+			*out = (uint8_t)ws_rd(ch, 0x18);
+			return 0;
+		}
+		delay(1);
+	}
+	return -1;
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
