index 0000000..25b64fc
--- /dev/null
+++ b/iokit/Kernel/arm/WhyredAdreno.cpp
@@ -0,0 +1,327 @@
+/*
+ * whyred: the Adreno 509 behind RedwoodGPU.cpp (the msm DRM user client Mesa talks to). Takes the place of topaz's
+ * TopazAdreno.cpp (Adreno 610) with the same exports. The hardware is bsd/dev/whyred_gpu.c (stage 1 steps 1-12,
+ * whyred/research/gpu-stage1.md); this file is the GPU memory pool and the glue.
+ *
+ * The SMMU passes addresses through (identity context bank, step 6): GPU address = physical address, so every
+ * buffer is contiguous. They come from a pool of RAM the kernel does not manage, 0xa2000000 + 256 MiB, between the
+ * GPU's own memory (0xa1400000) and the XNU base (0xb2000000, whyred/tools/mkadt_whyred.py), mapped write-combined.
+ * Boot-arg gpu=1 or whyredgpusvc=1 starts it (whyred_gpu.c).
+ */
+#include <IOKit/IOLib.h>
+#include <IOKit/IOMemoryDescriptor.h>
+#include <IOKit/IOLocks.h>
+#include <libkern/OSAtomic.h>
+#include <pexpert/pexpert.h>
+
+extern "C" {
+void sweet_dcache_flush(vm_offset_t addr, unsigned length);   /* osfmk/arm/caches.c: clean + invalidate */
+bool whyred_gpu_up(void);                                       /* bsd/dev/whyred_gpu.c */
+uint32_t whyred_gpu_submit(const uint64_t *addresses, const uint32_t *words, uint32_t count);
+uint32_t whyred_gpu_fence(void);
+uint32_t whyred_gpu_last(void);
+uint64_t whyred_gpu_timestamp(void);
+void whyred_gpu_report(const char *why);
+void whyred_gpu_stop(void);
+
+void topaz_adreno_init(void);
+bool redwood_gpu_ready(void);
+bool redwood_gpu_identity(void);
+bool redwood_gpu_parameter(uint32_t which, uint64_t *value);
+uint64_t redwood_gpu_address(uint64_t size);
+void redwood_gpu_address_free(uint64_t address, uint64_t size);
+bool redwood_gpu_map(uint64_t address, uint64_t phys, bool read_only);
+void redwood_gpu_mapped(void);
+void redwood_gpu_unmap(uint64_t address, uint64_t size);
+void redwood_gpu_to_memory(void *start, uint64_t size);
+uint32_t redwood_gpu_submit(const uint64_t *addresses, const uint32_t *words, uint32_t count);
+bool redwood_gpu_done(uint32_t fence);
+uint32_t redwood_gpu_last(void);
+void redwood_gpu_worked(uint64_t *microseconds, uint32_t *submissions, uint32_t by[7]);
+void redwood_gpu_report(const char *why);
+void redwood_gpu_stop(void);
+void redwood_tl(const char *format, ...) __printflike(1, 2);
+IOMemoryDescriptor *topaz_gpu_pool_md(uint64_t pa, uint64_t size);
+bool topaz_gpu_midmem(void);
+uint64_t topaz_gpu_pool_alloc(uint64_t size, void **va);
+void topaz_gpu_pool_free(uint64_t pa, uint64_t size);
+uint32_t gpu_log;
+}
+
+#define GPU_POOL_BASE       0xa2000000ull
+#define GPU_POOL_SIZE       0x10000000ull       /* 256 MiB */
+#define GPU_POOL_UNIT       0x10000ull          /* 64 KiB */
+#define GPU_POOL_CHUNK      0x4000000ull        /* 64 MiB, each mapped on first use */
+#define GPU_POOL_CHUNKS     (GPU_POOL_SIZE / GPU_POOL_CHUNK)
+
+#define A509_GMEM_SIZE      0x44000             /* 256 + 16 KiB */
+#define A509_GMEM_BASE      0x100000
+#define A509_MHZ            300                 /* GPLL0 / 2, step 12 */
+
+static IOLock *pool_lock, *submit_lock;
+static uint8_t *chunk_va[GPU_POOL_CHUNKS];
+static bool pool_ready;
+static struct range { uint64_t start, size; } pool_free[1024];
+static unsigned pool_free_count;
+static uint64_t pool_used, pool_peak;
+
+static void
+range_free(uint64_t address, uint64_t size)
+{
+	struct range *f = pool_free;
+	unsigned at;
+
+	for (at = 0; at < pool_free_count && f[at].start < address; at++) {
+	}
+	if (at > 0 && f[at - 1].start + f[at - 1].size == address) {
+		f[at - 1].size += size;
+		if (at < pool_free_count && address + size == f[at].start) {
+			f[at - 1].size += f[at].size;
+			memmove(&f[at], &f[at + 1], (--pool_free_count - at) * sizeof(f[0]));
+		}
+	} else if (at < pool_free_count && address + size == f[at].start) {
+		f[at].start = address;
+		f[at].size += size;
+	} else if (pool_free_count < sizeof(pool_free) / sizeof(pool_free[0])) {
+		memmove(&f[at + 1], &f[at], (pool_free_count - at) * sizeof(f[0]));
+		pool_free_count++;
+		f[at].start = address;
+		f[at].size = size;
+	}
+}
+
+static uint64_t
+range_alloc(uint64_t size)
+{
+	struct range *f = pool_free;
+
+	for (unsigned i = 0; i < pool_free_count; i++) {
+		if (f[i].size >= size) {
+			uint64_t address = f[i].start;
+			f[i].start += size;
+			f[i].size -= size;
+			if (f[i].size == 0) {
+				memmove(&f[i], &f[i + 1], (--pool_free_count - i) * sizeof(f[0]));
+			}
+			return address;
+		}
+	}
+	return 0;
+}
+
+/* The cache mode goes into the descriptor: user mappings of RAM the kernel does not manage are Device memory otherwise */
+IOMemoryDescriptor *
+topaz_gpu_pool_md(uint64_t pa, uint64_t size)
+{
+	return IOMemoryDescriptor::withAddressRange(pa, size,
+	           kIODirectionInOut | (kIOWriteCombineCache << kIOMemoryBufferCacheShift), TASK_NULL);
+}
+
+bool
+topaz_gpu_midmem(void)
+{
+	return false;
+}
+
+uint64_t
+topaz_gpu_pool_alloc(uint64_t size, void **va)
+{
+	uint64_t pa;
+
+	size = (size + GPU_POOL_UNIT - 1) & ~(GPU_POOL_UNIT - 1);
+	if (size > GPU_POOL_CHUNK - GPU_POOL_UNIT || pool_lock == NULL) {
+		return 0;
+	}
+	IOLockLock(pool_lock);
+	if (!pool_ready) {
+		/* one range per chunk, a unit short so that neighbours never merge: no buffer crosses a chunk */
+		for (uint64_t c = 0; c < GPU_POOL_CHUNKS; c++) {
+			range_free(GPU_POOL_BASE + c * GPU_POOL_CHUNK, GPU_POOL_CHUNK - GPU_POOL_UNIT);
+		}
+		pool_ready = true;
+	}
+	pa = range_alloc(size);
+	if (pa == 0) {
+		IOLockUnlock(pool_lock);
+		IOLog("WhyredAdreno: pool full: %llu bytes asked, %llu MiB in use\n", size, pool_used >> 20);
+		return 0;
+	}
+	unsigned c = (unsigned)((pa - GPU_POOL_BASE) / GPU_POOL_CHUNK);
+	if (chunk_va[c] == NULL) {
+		IOMemoryDescriptor *md = topaz_gpu_pool_md(GPU_POOL_BASE + c * GPU_POOL_CHUNK, GPU_POOL_CHUNK);
+		IOMemoryMap *map = md != NULL ? md->map(kIOMapWriteCombineCache) : NULL;
+		if (map != NULL) {
+			chunk_va[c] = (uint8_t *)map->getVirtualAddress();     /* kept for good, with md */
+		}
+		if (chunk_va[c] == NULL) {
+			OSSafeReleaseNULL(map);
+			OSSafeReleaseNULL(md);
+			range_free(pa, size);
+			IOLockUnlock(pool_lock);
+			IOLog("WhyredAdreno: pool chunk %u cannot be mapped\n", c);
+			return 0;
+		}
+		IOLog("WhyredAdreno: pool chunk %u mapped at %p\n", c, chunk_va[c]);
+	}
+	pool_used += size;
+	if (pool_used > pool_peak) {
+		pool_peak = pool_used;
+		if ((pool_peak >> 24) != ((pool_peak - size) >> 24)) {
+			IOLog("WhyredAdreno: pool peak %llu MiB of %llu\n", pool_peak >> 20, GPU_POOL_SIZE >> 20);
+		}
+	}
+	IOLockUnlock(pool_lock);
+	if (va != NULL) {
+		*va = chunk_va[c] + (pa - GPU_POOL_BASE - c * GPU_POOL_CHUNK);
+	}
+	return pa;
+}
+
+void
+topaz_gpu_pool_free(uint64_t pa, uint64_t size)
+{
+	size = (size + GPU_POOL_UNIT - 1) & ~(GPU_POOL_UNIT - 1);
+	if (pool_lock == NULL || pa < GPU_POOL_BASE || pa + size > GPU_POOL_BASE + GPU_POOL_SIZE) {
+		return;
+	}
+	IOLockLock(pool_lock);
+	range_free(pa, size);
+	pool_used -= size;
+	IOLockUnlock(pool_lock);
+}
+
+/* whyred_gpu.c starts the hardware itself (sweet_thermal_init); here only the locks */
+void
+topaz_adreno_init(void)
+{
+	if (pool_lock == NULL) {
+		pool_lock = IOLockAlloc();
+		submit_lock = IOLockAlloc();
+	}
+}
+
+bool
+redwood_gpu_ready(void)
+{
+	return whyred_gpu_up();
+}
+
+bool
+redwood_gpu_identity(void)
+{
+	return true;
+}
+
+bool
+redwood_gpu_parameter(uint32_t which, uint64_t *value)
+{
+	switch (which) {
+	case 0x01: *value = 509; return true;                           /* GPU_ID */
+	case 0x02: *value = A509_GMEM_SIZE; return true;                /* GMEM_SIZE */
+	case 0x03: *value = 0x05000900; return true;                    /* CHIP_ID */
+	case 0x04: *value = A509_MHZ * 1000000ull; return true;         /* MAX_FREQ */
+	case 0x05: *value = whyred_gpu_timestamp(); return true;        /* TIMESTAMP: RBBM always-on counter */
+	case 0x06: *value = A509_GMEM_BASE; return true;                /* GMEM_BASE */
+	case 0x07: *value = 1; return true;                             /* PRIORITIES */
+	case 0x08: case 0x09: case 0x0a: case 0x11:                     /* PP_PGTABLE FAULTS SUSPENDS RAYTRACING */
+		*value = 0;
+		return true;
+	default:
+		return false;
+	}
+}
+
+/* identity: no GPU address space of its own; freeing an address gives the pool memory back */
+uint64_t
+redwood_gpu_address(uint64_t size)
+{
+	(void)size;
+	return 0;
+}
+
+void
+redwood_gpu_address_free(uint64_t address, uint64_t size)
+{
+	topaz_gpu_pool_free(address, size);
+}
+
+bool
+redwood_gpu_map(uint64_t address, uint64_t phys, bool read_only)
+{
+	(void)address;
+	(void)phys;
+	(void)read_only;
+	return true;
+}
+
+void
+redwood_gpu_mapped(void)
+{
+}
+
+void
+redwood_gpu_unmap(uint64_t address, uint64_t size)
+{
+	(void)address;
+	(void)size;
+}
+
+void
+redwood_gpu_to_memory(void *start, uint64_t size)
+{
+	if (start != NULL && size != 0) {
+		sweet_dcache_flush((vm_offset_t)start, (unsigned)size);
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+uint32_t
+redwood_gpu_submit(const uint64_t *addresses, const uint32_t *words, uint32_t count)
+{
+	if (submit_lock == NULL) {
+		return 0;
+	}
+	IOLockLock(submit_lock);
+	uint32_t fence = whyred_gpu_submit(addresses, words, count);
+	IOLockUnlock(submit_lock);
+	return fence;
+}
+
+bool
+redwood_gpu_done(uint32_t fence)
+{
+	return (int32_t)(whyred_gpu_fence() - fence) >= 0;
+}
+
+uint32_t
+redwood_gpu_last(void)
+{
+	return whyred_gpu_last();
+}
+
+void
+redwood_gpu_worked(uint64_t *microseconds, uint32_t *submissions, uint32_t by[7])
+{
+	*microseconds = 0;
+	*submissions = 0;
+	bzero(by, 7 * sizeof(uint32_t));
+}
+
+void
+redwood_gpu_report(const char *why)
+{
+	whyred_gpu_report(why);
+	IOLog("WhyredAdreno: pool %llu MiB in use, peak %llu MiB\n", pool_used >> 20, pool_peak >> 20);
+}
+
+void
+redwood_gpu_stop(void)
+{
+	whyred_gpu_stop();
+}
+
+void
+redwood_tl(const char *format, ...)
+{
+	(void)format;
+}
