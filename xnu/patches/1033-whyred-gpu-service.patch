+ * The interface WhyredAdreno.cpp gives RedwoodGPU.cpp. The caller serialises submissions (its own lock).
+ */
+bool whyred_gpu_up(void);
+uint32_t whyred_gpu_submit(const uint64_t *addresses, const uint32_t *words, uint32_t count);
+uint32_t whyred_gpu_fence(void);
