+
+static uint32_t
+ring_space(void)
+{
+	uint32_t used = (ring_w - grd(A5_CP_RB_RPTR)) % RING_DW;
+	return RING_DW - 1 - used;
+}
+
+/* one CP_INDIRECT_BUFFER_PFE per command buffer, then CACHE_FLUSH_TS of the fence. 0: ring full or not up. */
+uint32_t
+whyred_gpu_submit(const uint64_t *addresses, const uint32_t *words, uint32_t count)
+{
+	uint32_t need = 4 * count + 5;
+	if (!gpu_up || need >= RING_DW / 2) {
+		return 0;
+	}
+	for (int spin = 0; ring_space() < need && spin < 20000; spin++) {
+		delay(100);
+	}
+	if (ring_space() < need) {
+		return 0;
+	}
+	for (uint32_t i = 0; i < count; i++) {
+		ring_put(pkt7(PKT_IB_PFE, 3));
+		ring_put((uint32_t)addresses[i]);
+		ring_put((uint32_t)(addresses[i] >> 32));
+		ring_put(words[i]);
+	}
+	if (++gpu_seq == 0) {
+		gpu_seq = 1;
+	}
+	ring_put(pkt7(PKT_EVENT_WRITE, 4));
+	ring_put(EV_CACHE_FLUSH_TS);
+	ring_put(GMEM_PA + FENCE_OFF + 0x40);
+	ring_put(0);
+	ring_put(gpu_seq);
+	__asm__ volatile ("dsb sy" ::: "memory");
+	gwr(A5_CP_RB_WPTR, ring_w % RING_DW);
+	return gpu_seq;
+}
+
+uint32_t
+whyred_gpu_fence(void)
+{
+	return gm != NULL ? *gmw(FENCE_OFF + 0x40) : 0;
+}
+
+uint32_t
+whyred_gpu_last(void)
+{
+	return gpu_seq;
+}
+
+uint64_t
+whyred_gpu_timestamp(void)
+{
+	if (!gpu_up) {
+		return 0;
+	}
+	uint32_t hi, lo;
+	do {
+		hi = grd(A5_RBBM_ALWAYSON_LO + 1);
+		lo = grd(A5_RBBM_ALWAYSON_LO);
+	} while (hi != grd(A5_RBBM_ALWAYSON_LO + 1));
+	return (uint64_t)hi << 32 | lo;
+}
+
+void
+whyred_gpu_report(const char *why)
+{
+	printf("WHYRED GPU: %s: fence %u done %u rptr %u wptr %u status %#x status3 %#x int0 %#x cp_int %#x hw_fault %#x ahb_err %#x\n",
+	    why, gpu_seq, whyred_gpu_fence(), grd(A5_CP_RB_RPTR), ring_w % RING_DW, grd(A5_RBBM_STATUS),
+	    grd(A5_RBBM_STATUS3), grd(A5_RBBM_INT_0_STATUS), grd(A5_CP_INT_STATUS), grd(A5_CP_HW_FAULT),
+	    grd(A5_RBBM_AHB_ERROR));
+	if (smmu != NULL) {
+		volatile uint8_t *cb = smmu + smmu_npage * smmu_psize;
+		printf("WHYRED GPU: smmu CB0 FSR %#x FAR %#x:%#x FSYNR0 %#x\n", rd(cb, 0x58), rd(cb, 0x64), rd(cb, 0x60),
+		    rd(cb, 0x68));
+	}
+}
+
+void
+whyred_gpu_stop(void)
+{
+	if (gpu_up) {
+		gwr(A5_CP_ME_CNTL, 0x303);      /* halt ME and PFP */
+	}
+	gpu_up = false;
 }
 
