 /*
- * The only registers this may write: PM660 (SID 1) LDO5 EN_CTL, the WCN3990 vdd-cx-mx supply
- * (TopazModem.cpp, wifi=1). Linux turns it on through RPM-SMD; ABL leaves it off.
+ * The only registers this may write, all on PM660 (SID 1):
+ *   0x4446       LDO5 EN_CTL, the WCN3990 vdd-cx-mx supply (TopazModem.cpp, wifi=1). Linux turns it on
+ *                through RPM-SMD; ABL leaves it off.
+ *   0xc0xx       the haptics block (live DT qcom,haptic@c000, ERM): EN_CTL 0x46, CFG1 0x4c, SEL 0x4e,
+ *                VMAX 0x51, ILIM 0x52, PLAY 0x70 (whyred_vibrate below).
  */
+static bool
+ws_write_allowed(unsigned sid, unsigned addr)
+{
+	if (sid != 1) {
+		return false;
+	}
+	switch (addr) {
+	case 0x4446:
+	case 0xc046: case 0xc04c: case 0xc04e: case 0xc051: case 0xc052: case 0xc070:
+		return true;
+	default:
+		return false;
+	}
+}
+
 static int
