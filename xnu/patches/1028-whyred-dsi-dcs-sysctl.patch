+
+/*
+ * whyred: one DSI packet to the panel for tests, v = data0 | data1 << 8 | data type << 16 | HS << 24 | read << 25.
+ * DCS short write 0x05 (no parameter) or 0x15 (one), DCS read 0x06. A read first sets the maximum return
+ * size to 1 (type 0x37), then sends the read with bus turnaround. rd[] gets the DSI read-back registers
+ * 0x060-0x074. Returns 1 when the command DMA finished, 0 when not, -1 without DSI.
+ */
+extern "C" int
+sweet_fb_dcs(uint32_t v, uint32_t rd[6])
+{
+	AppleCLCD *fb = sweet_fb_instance;
+	if (fb == NULL || fb->fDsiCmd == NULL || fb->fDsiBuf == NULL) {
+		return -1;
+	}
+	int hs = (v >> 24) & 1;
+	bool read = ((v >> 25) & 1) != 0;
+	uint8_t hdr[4] = { (uint8_t)v, (uint8_t)(v >> 8), (uint8_t)((v >> 16) & 0x3f), (uint8_t)(read ? 0xa0 : 0x80) };
+	bool done = true;
+	IOLockLock(fb->fBlLock);
+	if (read) {
+		const uint8_t max[4] = { 1, 0, 0x37, 0x80 };
+		done = fb->dsiSend(max, NULL, 0, hs);
+	}
+	done = done && fb->dsiSend(hdr, NULL, 0, hs);
+	if (read) {
+		IODelay(500);
+	}
+	for (int i = 0; i < 6; i++) {
+		rd[i] = dsi_rd(fb->fDsiCmd, 0x060 + 4 * i);
+	}
+	uint32_t ack = dsi_rd(fb->fDsiCmd, 0x0c4), status = dsi_rd(fb->fDsiCmd, 0x008);
+	IOLockUnlock(fb->fBlLock);
+	IOLog("SWEET FB: DCS %02x %02x type %02x %s%s: %s, rdbk %08x %08x %08x %08x %08x %08x ack %#x status %#x\n",
+	    hdr[0], hdr[1], hdr[2], hs ? "HS" : "LP", read ? " read" : "", done ? "done" : "NOT DONE",
+	    rd[0], rd[1], rd[2], rd[3], rd[4], rd[5], ack, status);
+	return done ? 1 : 0;
+}
