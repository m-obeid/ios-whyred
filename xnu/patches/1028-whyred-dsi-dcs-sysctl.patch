index 71e9b40..e88011b 100644
--- a/bsd/dev/whyred_spmi.c
+++ b/bsd/dev/whyred_spmi.c
@@ -396,6 +396,30 @@ sysctl_whyred_scanout SYSCTL_HANDLER_ARGS
 SYSCTL_PROC(_kern, OID_AUTO, whyred_scanout, CTLTYPE_INT | CTLFLAG_RW | CTLFLAG_LOCKED, NULL, 0,
     sysctl_whyred_scanout, "I", "whyred: display scanout (INTF_1 timing engine)");
 
+/*
+ * kern.whyred_dcs (root): write one DSI packet to the panel (SweetFramebuffer.cpp sweet_fb_dcs). Reading
+ * returns the last result: -1 no DSI, 0 not done, else read-back register 0x068 of a read (1 for a write).
+ */
+int sweet_fb_dcs(uint32_t v, uint32_t rd[6]);
+static int whyred_dcs_last = -1;
+
+static int
+sysctl_whyred_dcs SYSCTL_HANDLER_ARGS
+{
+#pragma unused(oidp, arg1, arg2)
+	int v = whyred_dcs_last, err = sysctl_handle_int(oidp, &v, 0, req);
+	if (err || req->newptr == USER_ADDR_NULL) {
+		return err;
+	}
+	uint32_t rd[6] = { 0 };
+	int r = sweet_fb_dcs((uint32_t)v, rd);
+	whyred_dcs_last = r == 1 && ((uint32_t)v >> 25 & 1) ? (int)rd[2] : r;
+	return r >= 0 ? 0 : ENODEV;
+}
+
+SYSCTL_PROC(_kern, OID_AUTO, whyred_dcs, CTLTYPE_INT | CTLFLAG_RW | CTLFLAG_LOCKED, NULL, 0,
+    sysctl_whyred_dcs, "I", "whyred: send one DSI packet to the panel");
+
 SYSCTL_PROC(_kern, OID_AUTO, whyred_usbin_suspend, CTLTYPE_INT | CTLFLAG_RW | CTLFLAG_LOCKED, NULL, 0,
     sysctl_whyred_usbin, "I", "whyred: seconds on the battery with the cable in");
 
