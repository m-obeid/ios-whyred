+			uint64_t n = polls + 1;
+			printf("WHYRED GOV: last minute %% at rows 0..4: %llu %llu %llu %llu %llu, %u changes, ceiling %u\n",
+			    at_row[0] * 100 / n, at_row[1] * 100 / n, at_row[2] * 100 / n, at_row[3] * 100 / n,
+			    at_row[4] * 100 / n, changes, cap);
+			for (int i = 0; i < GOV_ROWS; i++) {
+				at_row[i] = 0;
 			}
+			changes = 0;
+			polls = (unsigned)-1;           /* (the loop's increment makes it 0) */
 		}
-		polls++;
 		uint64_t deadline;
-		clock_interval_to_deadline(POLL_MS, NSEC_PER_MSEC, &deadline);
+		clock_interval_to_deadline(GOV_MS, NSEC_PER_MSEC, &deadline);
 		(void)assert_wait_deadline(&therm_chan, THREAD_UNINT, deadline);
 		thread_block(THREAD_CONTINUE_NULL);
 	}
