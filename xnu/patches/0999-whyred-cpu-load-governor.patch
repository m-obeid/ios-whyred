+	uint32_t max_row = rd(osm, OSM_DESIRED), cap = max_row, row = max_row;
+	unsigned cool = 0, polls = 0, invalid = 0, changes = 0;
+	uint64_t at_row[GOV_ROWS] = { 0 };
 
 	printf("WHYRED THERMAL: tsens trdy %#x, OSM enable %u, boot row %u, step down %d.%d C, up %d.%d C\n",
 	    rd(tsens, TSENS_TRDY), rd(osm, OSM_ENABLE), max_row, HOT_DC / 10, HOT_DC % 10,
 	    COOL_DC / 10, COOL_DC % 10);
-	if (!(rd(osm, OSM_ENABLE) & 1u) || max_row == 0) {
+	if (!(rd(osm, OSM_ENABLE) & 1u) || max_row == 0 || max_row >= GOV_ROWS) {
 		printf("WHYRED THERMAL: OSM not enabled by the shim, nothing to govern\n");
 		return;
 	}
-	for (;;) {
-		int t = gold_temp_dc();
-		if (t == NO_TEMP) {
-			if ((invalid++ % 20u) == 0) {
-				printf("WHYRED THERMAL: no valid Gold sensor reading (trdy %#x)\n", rd(tsens, TSENS_TRDY));
-			}
-		} else {
-			invalid = 0;
-			if (t >= CRIT_DC && row != 0) {
-				row = 0;
-				set_row(row, t);
-				cool = 0;
-			} else if (t >= HOT_DC && row > 1) {
-				row--;
-				set_row(row, t);
-				cool = 0;
-			} else if (t <= COOL_DC && row < max_row) {
-				if (++cool >= UP_HOLD_POLLS) {
-					row++;
-					set_row(row, t);
-					cool = 0;
+	printf("WHYRED GOV: %s, rows %u..%u, every %u ms\n", gov_on ? "by load" : "off (sweetgov=0)",
+	    GOV_FLOOR, max_row, GOV_MS);
+	for (;; polls++) {
+		if (polls % THERM_EVERY == 0) {
+			int t = gold_temp_dc();
+			uint32_t was = cap;
+			if (t == NO_TEMP) {
+				if ((invalid++ % 20u) == 0) {
+					printf("WHYRED THERMAL: no valid Gold sensor reading (trdy %#x)\n", rd(tsens, TSENS_TRDY));
 				}
 			} else {
-				cool = 0;
+				invalid = 0;
+				if (t >= CRIT_DC && cap != 0) {
+					cap = 0;
+					cool = 0;
+				} else if (t >= HOT_DC && cap > 1) {
+					cap--;
+					cool = 0;
+				} else if (t <= COOL_DC && cap < max_row) {
+					if (++cool >= UP_HOLD_POLLS) {
+						cap++;
+						cool = 0;
+					}
+				} else {
+					cool = 0;
+				}
+				if (cap != was) {
+					printf("WHYRED THERMAL: gold %d.%d C -> OSM ceiling row %u\n", t / 10, t % 10, cap);
+				}
+				if (therm_mode == 2 && (polls % (10000 / GOV_MS)) == 0) {
+					uint32_t cs = rd(cprh, CPRH_STATUS);
+					printf("WHYRED THERMAL: gold %d.%d C, OSM row %u, CPRH corner %u %u mV\n", t / 10, t % 10,
+					    row, cs & 0x3fu, (cs >> 6) & 0xfffu);
+					lse_report(10);
+				}
 			}
-			if (therm_mode == 2 && (polls % (10000 / POLL_MS)) == 0) {
-				uint32_t cs = rd(cprh, CPRH_STATUS);
-				printf("WHYRED THERMAL: gold %d.%d C, OSM row %u, CPRH corner %u %u mV\n", t / 10, t % 10,
-				    row, cs & 0x3fu, (cs >> 6) & 0xfffu);
-				lse_report(10);
+		}
+		uint32_t busy = gov_busy();
+		uint32_t next = gov_on ? gov_pick(row, cap, busy) : cap;
+		if (next > cap) {
