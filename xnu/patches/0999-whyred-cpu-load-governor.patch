  * OSM performance request (DCVS_PERF_STATE_DESIRED, perf block 0x179c3f10) down when hot and back
  * up when cool. Linux's own step trip for these zones is 105 C, critical 115/125 C.
  *
+ * Patch 0999 adds a load governor in the same thread. Every 50 ms it takes the busy share of the
+ * busiest CPU (whyred_cpu_idle_mach, osfmk/kern/recount.c) and picks the lowest OSM row that covers
+ * that load at the current speed with a quarter to spare; at once up, to the top row from 90 % busy,
+ * and down only after four looks in a row wanted less (to the most any of them wanted). The floor is
+ * row 1 (1113.6 MHz, 700 mV like row 0 at 288 MHz); the thermal steps set the ceiling. The idea and
+ * the numbers follow oosexgang/hakios-xnu-kernel drivers/board/cpufreq.c (MIT). The gain at idle is
+ * the voltage: 700 mV instead of 840 mV.
+ *
  * boot-args: sweettherm=0 off, 1 on (default), 2 also log the temperature and LSE emulation
- *            rates every 10 s. sweettherm_hot / sweettherm_cool: step thresholds in deci-C
+ *            rates every 10 s. sweetgov=0: no load governor, the ceiling row all the time. sweettherm_hot / sweettherm_cool: step thresholds in deci-C
  *            (default 900 / 750, for testing the steps; the 105 C trip is fixed).
  */
 #if defined(ARM64_BOARD_CONFIG_SWEET)
 #include <sys/param.h>
 #include <sys/systm.h>
 #include <kern/clock.h>
+#include <mach/mach_time.h>
 #include <kern/thread.h>
 #include <kern/sched_prim.h>
 #include <machine/machine_routines.h>
@@ -40,6 +49,17 @@ static int COOL_DC = 750;                       /* step up at 75.0 C */
 #define NO_TEMP                 (-100000)       /* no valid sensor */
 #define POLL_MS                 500
 #define UP_HOLD_POLLS           4               /* at most one step up every 2 s */
+#define GOV_MS                  50              /* how often the load is looked at */
+#define THERM_EVERY             (POLL_MS / GOV_MS)
+#define GOV_ROWS                5
+#define GOV_FLOOR               1
+#define GOV_HEADROOM_PCT        125
+#define GOV_UP_BUSY             90
+#define GOV_DOWN_LOOKS          4
+#define GOV_CPUS                8
+static const uint32_t gov_mhz[GOV_ROWS] = { 288, 1114, 1402, 1747, 1805 };   /* OSM rows 0..4 (shim) */
+extern uint64_t whyred_cpu_idle_mach(int cpu);  /* osfmk/kern/recount.c (patch 0999) */
+static int gov_on = 1;
 
 /* osfmk/arm64/sleh.c (patch 0968): LSE/LDAPR emulation statistics. */
 extern uint64_t sweet_lse_ops[11];
@@ -88,11 +108,62 @@ gold_temp_dc(void)
 }
 
 static void
-set_row(uint32_t row, int temp)
+write_row(uint32_t row)
 {
 	*(volatile uint32_t *)(osm + OSM_DESIRED) = row;
 	__asm__ volatile ("dsb sy" ::: "memory");
-	printf("WHYRED THERMAL: gold %d.%d C -> OSM row %u\n", temp / 10, temp % 10, row);
+}
+
+/* The busiest CPU's busy share since the last call, in percent. */
+static uint32_t
+gov_busy(void)
+{
+	static uint64_t last_idle[GOV_CPUS], last_t;
+	uint64_t now = mach_absolute_time(), dt = now - last_t;
+	uint32_t most = 0;
+	for (int c = 0; c < GOV_CPUS; c++) {
+		uint64_t idle = whyred_cpu_idle_mach(c);
+		if (idle == UINT64_MAX) {
+			continue;
+		}
+		if (last_t != 0 && dt != 0) {
+			uint64_t di = idle - last_idle[c];
+			uint32_t busy = di >= dt ? 0 : (uint32_t)((dt - di) * 100 / dt);
+			if (busy > most) {
+				most = busy;
+			}
+		}
+		last_idle[c] = idle;
+	}
+	last_t = now;
+	return most;
+}
+
+/* The row for the next GOV_MS, from the current one, the thermal ceiling and the load. */
+static uint32_t
+gov_pick(uint32_t cur, uint32_t cap, uint32_t busy)
+{
+	static uint32_t down_looks, down_most;
+	uint32_t need = gov_mhz[cur] * busy * GOV_HEADROOM_PCT / 10000, want = GOV_FLOOR;
+	while (want < cap && gov_mhz[want] < need) {
+		want++;
+	}
+	if (busy >= GOV_UP_BUSY || want > cap) {
+		want = cap;
+	}
+	if (want >= cur) {
+		down_looks = down_most = 0;
+		return want;
+	}
+	if (want > down_most) {
+		down_most = want;
+	}
+	if (++down_looks < GOV_DOWN_LOOKS) {
+		return cur;
+	}
+	want = down_most;
+	down_looks = down_most = 0;
+	return want;
 }
 
 /* Emulated LSE ops in the last interval, by op, and the four hottest PCs overall. */
@@ -136,51 +207,78 @@ lse_report(unsigned secs)
