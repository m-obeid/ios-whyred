+#if defined(ARM64_BOARD_CONFIG_SWEET)
+/*
+ * whyred CPU governor (bsd/dev/sweet_thermal.c): a CPU's idle time so far, in Mach time, including the
+ * idle period it is in now. UINT64_MAX for a CPU number without a processor.
+ */
+uint64_t whyred_cpu_idle_mach(int cpu);
+uint64_t
+whyred_cpu_idle_mach(int cpu)
+{
+	if (cpu < 0 || cpu >= MAX_SCHED_CPUS || processor_array[cpu] == PROCESSOR_NULL) {
+		return UINT64_MAX;
+	}
+	struct recount_usage usage = { 0 };
+	uint64_t idle = 0;
+	recount_processor_usage(&processor_array[cpu]->pr_recount, &usage, &idle);
+	return idle;
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
