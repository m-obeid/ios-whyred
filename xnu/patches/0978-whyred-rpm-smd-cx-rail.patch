+/*
+ * whyred: memshare server (Linux drivers/soc/qcom/memshare/msm_memshare.c, QMI service 0x34 v1
+ * instance 1). The modem asks for client 1 (15 MB) just before the WLAN firmware is ready on
+ * Linux. Clients from the live DT qcom,memshare: id 0 2 MB, id 1 15 MB, id 2 3 MB, all proc 0
+ * (MPSS). The blocks sit in RAM neither XNU (from 0xa2000000) nor a carve-out uses
+ * (Linux System RAM 0x94b00000-0x9fffffff, below the splash at 0x9d400000).
+ *   0x24 QUERY_SIZE: 0x01 client_id -> 0x10 size
+ *   0x22 ALLOC_GENERIC: 0x01 bytes, 0x02 client_id, 0x03 proc_id, 0x04 sequence_id
+ *        -> 0x10 sequence_id, 0x11 { u8 n, { u64 phys, u32 bytes } }
+ *   0x23 FREE_GENERIC -> result only (the block stays assigned to the modem)
+ * The first ALLOC of a client hands its block to MSS_MSA (shared_hyp_mapping).
+ */
+#define MEMSHARE_BASE       0x96000000ull
+static const struct { uint32_t id, size, off; } ms_client[3] = {
+	{ 0, 0x200000, 0 }, { 1, 0xf00000, 0x200000 }, { 2, 0x300000, 0x1100000 },
+};
+static bool ms_assigned[3];
+static IOMemoryMap *ms_map;
+
+static void
+memshare_rx(uint32_t node, uint32_t port, uint16_t txn, uint16_t msg, const uint8_t *d, uint32_t len)
+{
+	struct qmsg m;
+	uint16_t l = 0;
+	uint32_t client = ~0u, bytes = 0, seq = 0;
+	const uint8_t *v;
+	unsigned k;
+
+	qm_init(&m, txn, msg);
+	v = qm_find(d, len, msg == 0x22 ? 0x02 : 0x01, &l);
+	if (v != NULL && l >= 4) {
+		memcpy(&client, v, 4);
+	}
+	for (k = 0; k < 3 && ms_client[k].id != client; k++) {
+	}
+	switch (msg) {
+	case 0x24:                                  /* QUERY_SIZE */
+		LOG("t=%u ms: memshare: query client %u -> %x", g_ms, client, k < 3 ? ms_client[k].size : 0);
+		qm_result(&m, k < 3);
+		if (k < 3) {
+			uint32_t sz = ms_client[k].size;
+			qm_tlv(&m, 0x10, &sz, 4);
+		}
+		break;
+	case 0x22: {                                /* ALLOC_GENERIC */
+		if ((v = qm_find(d, len, 0x01, &l)) != NULL && l >= 4) {
+			memcpy(&bytes, v, 4);
+		}
+		if ((v = qm_find(d, len, 0x04, &l)) != NULL && l >= 4) {
+			memcpy(&seq, v, 4);
+		}
+		bool ok = k < 3 && bytes > 0;
+		uint64_t pa = k < 3 ? MEMSHARE_BASE + ms_client[k].off : 0;
+		if (ok && bytes > ms_client[k].size) {
+			bytes = ms_client[k].size;
+		}
+		if (ok && !ms_assigned[k]) {
+			if (ms_map == NULL) {
+				ms_map = map_phys(MEMSHARE_BASE, 0x1400000, true);
+			}
+			if (ms_map != NULL) {
+				bzero((void *)(ms_map->getVirtualAddress() + ms_client[k].off), ms_client[k].size);
+			}
+			static const uint32_t msa[1] = { VMID_MSS_MSA };
+			uint64_t r = scm_assign(pa, ms_client[k].size, msa, 1);
+			ok = r == 0;
+			ms_assigned[k] = ok;
+		}
+		LOG("t=%u ms: memshare: alloc client %u, %x bytes, seq %u -> %llx %s", g_ms, client, bytes, seq, pa,
+		    ok ? "ok" : "FAILED");
+		qm_result(&m, ok);
+		qm_tlv(&m, 0x10, &seq, 4);
+		if (ok) {
+			uint8_t a[13];
+			a[0] = 1;
+			memcpy(a + 1, &pa, 8);
+			memcpy(a + 9, &bytes, 4);
+			qm_tlv(&m, 0x11, a, sizeof(a));
+		}
+		break;
+	}
+	case 0x23:                                  /* FREE_GENERIC */
+		LOG("t=%u ms: memshare: free (kept assigned)", g_ms);
+		qm_result(&m, true);
+		break;
+	default:
+		LOG("t=%u ms: memshare: message %x", g_ms, msg);
+		qm_result(&m, false);
+		break;
+	}
+	qm_send(&m, PORT_MEMSHARE, node, port);
 }
 
