+extern void sweet_dcache_clean(vm_offset_t addr, unsigned length);
+extern void sweet_dcache_flush(vm_offset_t addr, unsigned length);
+extern void sweet_usb_probe(void);
+extern kern_return_t kernel_thread_start(thread_continue_t, void *, thread_t *);
+extern void thread_deallocate(thread_t);
 extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
 
 /* GCC SDCC1 branch clocks: bit 31 = CLK_OFF */
@@ -260,9 +267,9 @@
 		d[n].addr_lo = (uint32_t)pa;
 		d[n].addr_hi = (uint32_t)(pa >> 32);
 	}
-	clean_dcache64((addr64_t)(se.dma_pa + DMA_DESC), (unsigned)(n * sizeof(struct adma_desc)), TRUE);
+	sweet_dcache_clean(se.dma + DMA_DESC, (unsigned)(n * sizeof(struct adma_desc)));
 	/* Reads: no dirty line may be written back over the incoming data. Writes: data to RAM. */
-	flush_dcache64((addr64_t)(se.dma_pa + DMA_BOUNCE), bytes, TRUE);
+	sweet_dcache_flush(se.dma + DMA_BOUNCE, bytes);
 	__builtin_arm_dsb(0xf);
 
 	int error = lines_idle(3);
@@ -303,7 +310,8 @@
 			return EIO;
 		}
 	} else {
-		flush_dcache64((addr64_t)(se.dma_pa + DMA_BOUNCE), bytes, TRUE);
+		/* Drop lines the CPU may have speculatively fetched during the transfer. */
+		sweet_dcache_flush(se.dma + DMA_BOUNCE, bytes);
 	}
 	return 0;
 }
@@ -744,6 +752,13 @@
 	return 0;
 }
 
+/* USB (bsd/dev/sweet_usb.c) in its own thread: a bus hang there must not stop the root mount. */
+static void
+sweet_emmc_usb_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	sweet_usb_probe();
+}
+
 /* Root device for rd=emmcroot0 (IOFindBSDRoot). */
 int sweet_emmc_rootdev(dev_t *dev);
 
@@ -757,6 +772,14 @@
 		}
 	}
 	*dev = se.bdev;
+	static bool usb_started;
+	if (!usb_started) {
+		usb_started = true;
+		thread_t t;
+		if (kernel_thread_start(sweet_emmc_usb_thread, NULL, &t) == KERN_SUCCESS) {
+			thread_deallocate(t);
+		}
+	}
 	return 0;
 }
