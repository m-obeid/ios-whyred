-#define HAP_DEV_AHEAD   40
+#define HAP_DEV_MIN     20      /* 1018 ran a tap for 70 ms at 3000 mV: too strong for icon presses */
+#define HAP_DEV_AHEAD   15
+#define HAP_DEV_LOW_MV  1200u
 
