 	(void)mic_ops(mic_on_ops, sizeof(mic_on_ops) / sizeof(mic_on_ops[0]), "on");
+	mic_dump("on");
 	int r = apr_call_port(APR_SVC_ASM, MIC_PORT, ASM_SESSION_CMD_RUN_V2, p, 12, 1000);
 	IOLockLock(mic_lock);
 	mic_rd = mic_wr;
@@ -3642,7 +3690,7 @@ mic_poll(void)
 		IOLockUnlock(mic_lock);
 		mic_bytes += n;
 		if (mic_bytes == n) {
-			LOG("t=%u.%03u mic: first %u bytes", T, n);
+			LOG("t=%u.%03u mic: first %u bytes (offset %u, buffer %u)", T, n, d.offset, i);
 		}
 	}
 	if (!mic_on) {
@@ -3854,4 +3902,5 @@ topaz_audio_init(void)
 
 #else
 extern "C" void topaz_audio_init(void) {}
+extern "C" int whyred_mic_mmio(int, int, unsigned, uint32_t *) { return -1; }
