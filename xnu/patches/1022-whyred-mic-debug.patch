diff --git a/bsd/dev/whyred_spmi.c b/bsd/dev/whyred_spmi.c
index f1929ed..05f377b 100644
--- a/bsd/dev/whyred_spmi.c
+++ b/bsd/dev/whyred_spmi.c
@@ -665,6 +665,42 @@ sysctl_whyred_torch SYSCTL_HANDLER_ARGS
 	return whyred_torch(v) == 0 ? 0 : EIO;
 }
 
+/*
+ * kern.whyred_codec (root): one register access for bring-up of the microphone. Write a command:
+ *   bits 31-28 op: 1 PM660L SPMI read, 2 SPMI write (SID 3 0xf000-0xf1ff), 3 digital codec read,
+ *   4 digital codec write, 5 LPI TLMM read, 6 LPI TLMM write (both only while /dev/redwood-mic is open);
+ *   bits 27-8 register, bits 7-0 value. Read: the result of the last command (-1 = failed).
+ */
+int whyred_mic_mmio(int lpi, int write, unsigned off, uint32_t *val);
+static int codec_last = -1;
+
+static int
+sysctl_whyred_codec SYSCTL_HANDLER_ARGS
+{
+#pragma unused(oidp, arg1, arg2)
+	int v = codec_last, err = sysctl_handle_int(oidp, &v, 0, req);
+	if (err || req->newptr == USER_ADDR_NULL) {
+		return err;
+	}
+	unsigned op = (unsigned)v >> 28, reg = ((unsigned)v >> 8) & 0xfffffu;
+	uint8_t b = (uint8_t)v;
+	uint32_t w = (uint8_t)v;
+	int r = -1;
+	switch (op) {
+	case 1: r = whyred_spmi_read(3, reg, &b) == 0 ? b : -1; break;
+	case 2: r = whyred_spmi_write(3, reg, b) == 0 && whyred_spmi_read(3, reg, &b) == 0 ? b : -1; break;
+	case 3: case 4: case 5: case 6:
+		r = whyred_mic_mmio(op >= 5, op == 4 || op == 6, reg, &w) == 0 ? (int)w : -1;
+		break;
+	default: break;
+	}
+	codec_last = r;
+	return 0;
+}
+
+SYSCTL_PROC(_kern, OID_AUTO, whyred_codec, CTLTYPE_INT | CTLFLAG_RW | CTLFLAG_LOCKED, NULL, 0,
+    sysctl_whyred_codec, "I", "whyred: codec register access (see whyred_spmi.c)");
+
 SYSCTL_PROC(_kern, OID_AUTO, whyred_torch, CTLTYPE_INT | CTLFLAG_RW | CTLFLAG_ANYBODY | CTLFLAG_LOCKED, NULL, 0,
     sysctl_whyred_torch, "I", "whyred: flashlight 0 (off) to 100 percent");
 #endif /* ARM64_BOARD_CONFIG_SWEET */
