 	return bad == 0;
 }
 
+/* what the codecs hold now: the digital codec's TX path and clocks, the analog codec's ADC1 path */
+static void
+mic_dump(const char *when)
+{
+	static const uint16_t d[] = { 0x00c, 0x010, 0x018, 0x01c, 0x024, 0x028, 0x1a0, 0x284, 0x288, 0x28c };
+	static const uint16_t a[] = { 0xf004, 0xf005, 0xf046, 0xf048, 0xf049, 0xf04a, 0xf050, 0xf104, 0xf105, 0xf140,
+		                      0xf141, 0xf145, 0xf160, 0xf163, 0xf166 };
+	char line[256];
+	int n = 0;
+	for (unsigned i = 0; i < sizeof(d) / sizeof(d[0]) && n < 200; i++) {
+		n += snprintf(line + n, sizeof(line) - n, " %x=%x", d[i], mic_dig[d[i] / 4]);
+	}
+	LOG("mic: %s: digital%s", when, line);
+	n = 0;
+	for (unsigned i = 0; i < sizeof(a) / sizeof(a[0]) && n < 200; i++) {
+		uint8_t v = 0xee;
+		(void)whyred_spmi_read(3, a[i], &v);
+		n += snprintf(line + n, sizeof(line) - n, " %x=%x", a[i], v);
+	}
+	LOG("mic: %s: analog%s", when, line);
+}
+
+/* kern.whyred_codec (bsd/dev/whyred_spmi.c): the digital codec (lpi 0) or LPI TLMM (lpi 1), only while the mic runs */
+extern "C" int
+whyred_mic_mmio(int lpi, int write, unsigned off, uint32_t *val)
+{
+	if (!mic_on || mic_dig == NULL || (off & 3) != 0 || off >= (lpi ? 0xc000u : 0x1000u)) {
+		return -1;
+	}
+	volatile uint32_t *r;
+	if (lpi) {
+		vm_offset_t b = ml_io_map(LPI_TLMM_PA + (off & ~0xfffu), 0x1000);
+		if (b == 0) {
+			return -1;
+		}
+		r = (volatile uint32_t *)(b + (off & 0xfffu));
+	} else {
+		r = mic_dig + off / 4;
+	}
+	if (write) {
+		*r = *val;
+		mb();
+	}
+	*val = *r;
+	return 0;
+}
+
 static int
 afe_clock(uint32_t id, uint32_t hz, bool on)
 {
