diff --git a/bsd/dev/sweet_keys.c b/bsd/dev/sweet_keys.c
index 80d1e97..6d34080 100644
--- a/bsd/dev/sweet_keys.c
+++ b/bsd/dev/sweet_keys.c
@@ -114,13 +114,32 @@ static void
 keys_thread(void *arg, wait_result_t result)
 {
 	int state[3] = {0, 0, 0};
-	unsigned errors = 0, ticks = 0;
+	int cand[3] = {0, 0, 0};
+	unsigned same[3] = {0, 0, 0};
+	unsigned errors = 0, ticks = 0, bogus = 0;
 	(void)arg;
 	(void)result;
 	for (;;) {
 		uint8_t pon = 0, gpio = 0;
 		bool pok = keys_read(keys_pon_apid, KEYS_PON_RT, &pon);
 		bool gok = keys_read(keys_gpio_apid, KEYS_GPIO_RT, &gpio);
+		/*
+		 * whyred: with the modem up, some reads complete without an error bit but carry garbage
+		 * (GPIO7 RT_STS 0x10 / 0x88 / 0xfc, PON 0x75): ghost volume presses. GPIO RT_STS only
+		 * has bit 0; PON RT_STS bits 0-5. Drop such reads.
+		 */
+		unsigned bogus_before = bogus;
+		if (gok && (gpio & 0xfeu) != 0) {
+			gok = false;
+			bogus++;
+		}
+		if (pok && (pon & 0xc0u) != 0) {
+			pok = false;
+			bogus++;
+		}
+		if (bogus != bogus_before && (bogus & (bogus - 1)) == 0) {
+			printf("WHYRED KEYS: %u implausible reads dropped (last pon %#x gpio %#x)\n", bogus, pon, gpio);
+		}
 		int now[3] = {!!(pon & 1u), !(gpio & 1u), !!(pon & 2u)};
 		if (!pok || !gok) {
 			if ((errors++ % 250u) == 0) {
@@ -135,8 +154,18 @@ keys_thread(void *arg, wait_result_t result)
 			    pon, gpio, pok, gok, keys_last_status);
 		}
 		for (int k = 0; k < 3; ++k) {
-			if ((k == 1 ? gok : pok) && now[k] != state[k]) {
-				state[k] = now[k];
+			if (!(k == 1 ? gok : pok)) {
+				continue;
+			}
+			/* debounce: a change counts after 3 equal samples in a row (60 ms) */
+			if (now[k] != cand[k]) {
+				cand[k] = now[k];
+				same[k] = 1;
+			} else if (same[k] < 3) {
+				same[k]++;
+			}
+			if (same[k] >= 3 && cand[k] != state[k]) {
+				state[k] = cand[k];
 				printf("SWEET KEYS: key=%d down=%d pon=%#x gpio7:c610=%#x\n",
 				    k, state[k], pon, gpio);
 				sweet_hid_key(k, state[k]);
