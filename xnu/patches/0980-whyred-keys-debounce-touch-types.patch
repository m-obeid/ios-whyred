+/*
+ * whyred: synthetic touches for unattended tests (unlock after boot, taps), from the touch
+ * thread through report(): sysctl kern.whyred_touch = x1 | y1 << 12 | x2 << 24 | y2 << 36 |
+ * ms << 48 (pixels, 0..4095; a tap is x2 = x1, y2 = y1, short ms). One finger, id 0.
+ */
+static volatile uint64_t inj_req;
+
+static void
+inject_run(uint64_t r)
+{
+	int x1 = (int)(r & 0xfff), y1 = (int)((r >> 12) & 0xfff), x2 = (int)((r >> 24) & 0xfff);
+	int y2 = (int)((r >> 36) & 0xfff), ms = (int)((r >> 48) & 0xffff);
+	int steps = ms / 16 > 1 ? ms / 16 : 1;
+	int x[SYNA_MAX_OBJ] = {0}, y[SYNA_MAX_OBJ] = {0};
+	printf("WHYRED TOUCH: injected %d,%d -> %d,%d in %d ms\n", x1, y1, x2, y2, ms);
+	for (int i = 0; i <= steps; i++) {
+		x[0] = x1 + (x2 - x1) * i / steps;
+		y[0] = y1 + (y2 - y1) * i / steps;
+		report(1, x, y);
+		sleep_ms(16);
+	}
+	report(0, x, y);
+}
+
+static int
+whyred_touch_sysctl SYSCTL_HANDLER_ARGS
+{
+#pragma unused(oidp, arg1, arg2)
+	uint64_t v = 0;
+	int error = sysctl_handle_quad(oidp, &v, 0, req);
+	if (error == 0 && req->newptr != USER_ADDR_NULL) {
+		inj_req = v;
+	}
+	return error;
+}
+SYSCTL_PROC(_kern, OID_AUTO, whyred_touch, CTLTYPE_QUAD | CTLFLAG_RW | CTLFLAG_LOCKED, NULL, 0,
+    whyred_touch_sysctl, "Q", "inject a one-finger touch: x1 | y1<<12 | x2<<24 | y2<<36 | ms<<48");
+
 static void
 syna_thread(__unused void *arg, __unused wait_result_t wr_)
 {
