+/* (pool_lock held) every 30 s, when the use moved by 8 MiB or more: a leak shows as a line that only climbs */
+static void
+pool_tell(void)
+{
+	uint64_t now = mach_absolute_time(), ns;
+	absolutetime_to_nanoseconds(now - pool_told_at, &ns);
+	uint64_t moved = pool_used > pool_told_used ? pool_used - pool_told_used : pool_told_used - pool_used;
+	if (ns >= 30ull * NSEC_PER_SEC && moved >= (8ull << 20)) {
+		pool_told_at = now;
+		pool_told_used = pool_used;
+		IOLog("WhyredAdreno: pool %llu MiB in use (peak %llu of %llu), %u free ranges\n", pool_used >> 20, pool_peak >> 20,
+		    gpu_pool_size >> 20, pool_free_count);
+	}
+}
