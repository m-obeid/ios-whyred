+/*
+ * whyred: with gpu=1 the default surface is made in the GPU pool on first ask. CoreAnimation draws into it
+ * and its own second surface in turn. The panel memory as default was neither GPU memory (each frame read
+ * back, 128 ms) nor shown (present skips it as already in place, but the MDP scans the other one: flicker).
+ */
+SweetSurface *
+AppleCLCD::defaultSurface(void)
+{
+	static int gpu = -1;
+	if (gpu < 0) {
+		uint32_t on = 0, pool = 1;
+		gpu = PE_parse_boot_argn("gpu", &on, sizeof(on)) && on != 0 &&
+		    !(PE_parse_boot_argn("gpu_fbpool", &pool, sizeof(pool)) && pool == 0);
+	}
+	if (!gpu) {
+		return fSurface;
+	}
+	IOLockLock(fLock);
+	if (fGpuSurface == NULL) {
+		fGpuSurface = sweet_surface_create_gpu_pool(fWidth, fHeight, SWEET_FB_FORMAT_BGRA);
+		IOLog("SWEET FB: default surface %u in the GPU pool (%ux%u, %u bytes a row)\n",
+		    fGpuSurface != NULL ? fGpuSurface->id : 0, fWidth, fHeight, fGpuSurface != NULL ? fGpuSurface->bytesPerRow : 0);
+	}
+	SweetSurface *s = fGpuSurface != NULL ? fGpuSurface : fSurface;
+	IOLockUnlock(fLock);
+	return s;
+}
