+SweetSurface *
+sweet_surface_create_gpu_pool(uint32_t width, uint32_t height, uint32_t pixelFormat)
+{
+	SweetSurface *s = sweet_surface_alloc();
+	void *va = NULL;
+	if (s == NULL) {
+		return NULL;
+	}
+	s->width = width;
+	s->height = height;
+	s->bytesPerRow = (width * 4 + 255) & ~255u;
+	s->bytesPerElement = 4;
+	s->elementWidth = s->elementHeight = 1;
+	s->pixelFormat = pixelFormat;
+	s->allocSize = (uint32_t)sweet_round_upage(s->bytesPerRow * height);
+	uint64_t take = s->allocSize + 64ull * s->bytesPerRow;      /* the GPU's last tiles (see create) */
+	uint64_t pa = topaz_gpu_pool_alloc(take, &va);
+	IOMemoryDescriptor *md = pa != 0 ? topaz_gpu_pool_md(pa, s->allocSize) : NULL;
+	if (md == NULL) {
+		if (pa != 0) {
+			topaz_gpu_pool_free(pa, take);
+		}
+		s->release();
+		return NULL;
+	}
+	for (uint64_t i = 0; i < take; i += 8) {
+		*(volatile uint64_t *)((uint8_t *)va + i) = 0;
+	}
+	s->poolSize = take;
+	s->memory = md;
+	s->gpuPool = true;
+	s->scanoutPhys = pa;
+	s->mapCache = kIOMapDefaultCache;       /* (the descriptor says write-combined) */
+	if (!sweet_surface_publish(s)) {
+		s->release();
+		return NULL;
+	}
+	return s;
+}
